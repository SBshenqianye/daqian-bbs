*.tar.gz

# Deployment output
bbs-deploy/
bbs-offline/
bbs-deploy-latest.tar.gz
bbs-offline-latest.tar.gz

# Environment configuration (contains secrets)
.env

# 现场采集回传数据（禁止入库，只保留说明文件）
delivery/collect/回传/*
!delivery/collect/回传/README.txt

