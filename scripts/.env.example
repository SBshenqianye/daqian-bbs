# ============================================
# BBS 部署环境变量配置
# 复制此文件为 .env 并修改其中的值
#   cp scripts/.env.example .env
# ============================================

# ---------- 数据库 ----------
# PostgreSQL 连接信息（PostgreSQL 需自行启动，脚本不会自动管理）
#   容器部署: BBS_DB_HOST=容器名（如 bbs-postgres）
#   非容器部署: BBS_DB_HOST=数据库服务器 IP（如 127.0.0.1）
BBS_DB_HOST=127.0.0.1
BBS_DB_PORT=15432
BBS_DB_NAME=bbs
BBS_DB_USER=work_flow
BBS_DB_PASSWORD=your_password_here

# ---------- 后端 ----------
# Spring Boot 端口（生产环境 60000；开发环境默认 9083，不设此变量即可）
BBS_SERVER_PORT=60000

# 文件上传目录（必须以 / 结尾！无尾斜杠会导致后端拼出 bbsUploadcommon 等错误目录 → 图片 404）
BBS_UPLOAD_DIR=/data/bbs/bbsUpload/

# 超级管理员密码（默认 1234@abcD）
BBS_SUPER_ADMIN_PASSWORD=1234@abcD

# ---------- Nginx / 前端 ----------
# Nginx 监听端口
NGINX_PORT=60001

# ---------- Podman / Docker ----------
# PostgreSQL 容器名（生产环境容器名可能和测试不同，务必配置）
BBS_PG_CONTAINER=bbs-postgres
# 容器内 PostgreSQL 监听端口（容器内部端口，不是宿主机映射端口）
# 默认 5432；如果容器内 postgres 用了 -p 15432，这里也要设 15432
BBS_PG_INTERNAL_PORT=5432
# 备份后自动验证（true/false，默认 true）
BBS_BACKUP_VERIFY=true
# 后端容器名
BBS_SERVER_CONTAINER=bbs-server
# Nginx 容器名
BBS_NGINX_CONTAINER=bbs-nginx

# ---------- 镜像配置 ----------
# Docker/Podman 镜像仓库前缀（如需推送私有仓库）
IMAGE_PREFIX=
# 镜像标签
IMAGE_TAG=latest
