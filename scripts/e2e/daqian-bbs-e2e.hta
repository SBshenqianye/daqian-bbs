<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>大千智荟论坛 · 部署验收 E2E（Win7 HTA）</title>
<hta:application id="bbsE2E"
    applicationname="bbs-e2e"
    border="thin"
    caption="yes"
    icon="mshta.exe"
    maximizebutton="no"
    minimizebutton="yes"
    scroll="no"
    singleinstance="yes" />
<style type="text/css">
    html, body { margin: 0; padding: 0; background: #f4f6fa; color: #181c23;
        font-family: "Microsoft YaHei", "微软雅黑", Tahoma, Arial, sans-serif; font-size: 12.5px; }
    a { color: #0052d9; }
    .wrap { padding: 12px 16px 8px 16px; }
    .title { font-size: 17px; font-weight: bold; color: #0b2b66; }
    .title span { font-size: 11px; font-weight: normal; color: #7b8194; margin-left: 8px; }
    .card { background: #fff; border: 1px solid #dbe0ea; border-radius: 6px; padding: 9px 12px; margin-top: 9px; }
    .label { color: #5b6475; }
    input[type=text], input[type=password] {
        border: 1px solid #c9cfdb; border-radius: 4px; padding: 3px 6px; height: 20px;
        font-family: "Microsoft YaHei", Tahoma, Arial, sans-serif; font-size: 12.5px; }
    input[type=text]:focus, input[type=password]:focus { border-color: #7ba3ee; outline: none; }
    .btn { border: 1px solid #c3cbd9; background: #fff; color: #1f2a3d; border-radius: 4px;
        padding: 4px 12px; height: 26px; cursor: pointer; font-size: 12.5px;
        font-family: "Microsoft YaHei", Tahoma, Arial, sans-serif; }
    .btn:hover { border-color: #0052d9; color: #0052d9; }
    .btn-primary { background: #0052d9; border-color: #0052d9; color: #fff; }
    .btn-primary:hover { color: #fff; opacity: .9; }
    .btn[disabled] { color: #9aa2b1; border-color: #dfe3ea; background: #f5f6f8; cursor: default; }
    .summary { margin-top: 9px; padding: 7px 12px; background: #fff; border: 1px solid #dbe0ea; border-radius: 6px; }
    .summary b { font-size: 13.5px; }
    .ok { color: #0a7d33; }
    .fail { color: #c62828; }
    .skip { color: #8a6d1d; }
    .muted { color: #7b8194; }
    .bar { height: 6px; background: #e8ebf2; border-radius: 3px; margin-top: 7px; overflow: hidden; }
    .bar i { display: block; height: 6px; width: 0; background: #0052d9; }
    .gridWrap { height: 330px; overflow: auto; margin-top: 9px; border: 1px solid #dfe4ee; background: #fff; }
    table.grid { width: 100%; border-collapse: collapse; }
    table.grid th, table.grid td { border-bottom: 1px solid #eef1f6; padding: 4px 7px; text-align: left;
        vertical-align: top; font-size: 12px; }
    table.grid th { background: #f8fafd; color: #5b6475; font-weight: normal; position: sticky; top: 0; }
    table.grid tr.row { cursor: pointer; }
    table.grid tr.row:hover td { background: #f6f9ff; }
    table.grid tr.sel td { background: #eef4ff; }
    td.col-no { width: 32px; color: #8a91a1; }
    td.col-name { width: 210px; }
    td.col-state { width: 56px; }
    td.col-cost { width: 66px; color: #7b8194; }
    td.col-code { width: 52px; color: #7b8194; }
    .detail { margin-top: 9px; }
    .detail pre { margin: 5px 0 0 0; padding: 8px; background: #0f172a; color: #d7e2f5; border-radius: 5px;
        height: 132px; overflow: auto; font-family: Consolas, "Courier New", monospace; font-size: 11.5px;
        white-space: pre-wrap; word-wrap: break-word; }
    .hint { color: #7b8194; font-size: 11.5px; margin-top: 4px; }
    .warn { color: #a8620a; }
    .foot { margin-top: 6px; color: #8a91a1; font-size: 11px; }
</style>
</head>
<body>
<div class="wrap">
    <div class="title">大千智荟论坛 · 部署验收 E2E
        <span>单文件 HTA · 适用于 Windows 7（自带 mshta）</span>
    </div>

    <div class="card">
        <table cellspacing="0" cellpadding="0" border="0">
            <tr>
                <td class="label" width="66">服务地址</td>
                <td><input type="text" id="baseUrl" style="width:330px" value="http://127.0.0.1:9083/bbs-server"></td>
                <td class="label" width="64" align="right">超时(ms)</td>
                <td><input type="text" id="timeout" style="width:66px" value="15000"></td>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td class="label" style="padding-top:6px">验收账号</td>
                <td style="padding-top:6px"><input type="text" id="username" style="width:140px" value="">&nbsp;
                    <span class="label">密码</span>&nbsp;
                    <input type="password" id="password" style="width:140px" value=""></td>
                <td colspan="2" align="right" style="padding-top:6px">
                    <input type="checkbox" id="prodSafe" checked> <span class="warn">生产安全模式</span>&nbsp;&nbsp;
                    <input type="checkbox" id="writeMode"> <span class="warn">写入用例</span>
                </td>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td class="label" style="padding-top:6px">验收专用</td>
                <td colspan="4" style="padding-top:6px">
                    帖子 ID <input type="text" id="testArticleId" style="width:76px" value="">&nbsp;
                    标签 ID <input type="text" id="testLabelId" style="width:66px" value="">
                    <span class="hint" style="margin-left:6px">生产环境建议填一篇专用测试帖，避免浏览量自增</span>
                </td>
            </tr>
            <tr>
                <td class="label" style="padding-top:6px">前端地址</td>
                <td colspan="4" style="padding-top:6px">
                    <input type="text" id="frontUrl" style="width:290px" value="http://127.0.0.1:9081/bbs-user/">
                    &nbsp;<span class="label">Chrome</span>&nbsp;
                    <input type="text" id="chromePath" style="width:240px" value="">
                    <button class="btn" style="height:24px;padding:2px 8px" onclick="detectBrowserNow()">探测</button>
                    &nbsp;<input type="checkbox" id="shotEnabled" checked> <span class="hint">保存页面截图</span>
                    <div class="hint" id="browserHint">支持 Chrome / Edge / 360 安全浏览器 / 360 极速浏览器（自动探测）</div>
                </td>
            </tr>
        </table>
        <div class="hint">生产安全模式：不执行写入用例，帖子详情用 countView=false 读取（不增加浏览量），并跳过会给真实用户计算成就的接口；建议登录 <b>is_test_account=1</b> 的专用验收账号。完整模式：用于测试/预发环境，写入用例可选择执行并自动清理。</div>
    </div>

    <div style="margin-top:9px">
        <button class="btn btn-primary" id="btnRun" onclick="startRun()">开始验收</button>
        <button class="btn" id="btnStop" onclick="stopRun()" disabled>停止</button>
        <button class="btn" id="btnSave" onclick="saveReport()">保存报告</button>
        <button class="btn" onclick="window.close()">关闭</button>
    </div>

    <div class="summary">
        <b id="summaryText">尚未开始</b>
        <span class="muted" id="summarySub"></span>
        <div class="bar"><i id="progressBar"></i></div>
    </div>

    <div class="gridWrap">
        <table class="grid" id="resultTable" cellspacing="0" cellpadding="0">
            <thead>
            <tr>
                <th class="col-no">#</th>
                <th>用例</th>
                <th class="col-state">结果</th>
                <th class="col-cost">耗时</th>
                <th class="col-code">HTTP</th>
                <th>说明</th>
            </tr>
            </thead>
            <tbody id="resultBody"></tbody>
        </table>
    </div>

    <div class="detail card" style="padding:7px 12px">
        <div class="label">明细（点击上面任意一行查看请求与响应）</div>
        <pre id="detail">（暂无）</pre>
    </div>

    <div class="foot">报告保存到本文件所在目录；仅使用系统自带组件（mshta + WinHttp + ADODB），无需安装运行库。</div>
</div>

<script type="text/javascript">
/* ============================================================
 * 大千智荟论坛 · 部署验收 E2E（Windows 7 单文件 HTA）
 *  - 纯 ES5 + ActiveX（WinHttp / ADODB），不依赖任何外部库与浏览器驱动；
 *  - [公共] 只读用例覆盖首页/帖子/评论/精华/排行/等级/组织；
 *  - [账号]/[消息] 用例需要验收账号；
 *  - [写入] 用例默认关闭，创建的数据会被立即清理。
 * ============================================================ */

var TESTS = [];
var LAST_HTTP = null;
var state = {
    running: false,
    stopRequested: false,
    results: [],
    startedAt: null,
    ctx: {}
};

/* ---------- 通用工具 ---------- */

function byId(id) { return document.getElementById(id); }

function trimStr(s) {
    if (s === null || s === undefined) return '';
    s = String(s);
    return s.replace(/^\s+|\s+$/g, '');
}

function pad2(n) { return n < 10 ? '0' + n : String(n); }

function nowText() {
    var d = new Date();
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()) + ' ' +
        pad2(d.getHours()) + ':' + pad2(d.getMinutes()) + ':' + pad2(d.getSeconds());
}

function fileStamp() {
    var d = new Date();
    return '' + d.getFullYear() + pad2(d.getMonth() + 1) + pad2(d.getDate()) + '-' +
        pad2(d.getHours()) + pad2(d.getMinutes()) + pad2(d.getSeconds());
}

function escapeHtml(s) {
    s = (s === null || s === undefined) ? '' : String(s);
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function clip(s, n) {
    s = (s === null || s === undefined) ? '' : String(s);
    return s.length > n ? s.substring(0, n) + ' ...' : s;
}

function isArray(v) {
    return Object.prototype.toString.call(v) === '[object Array]';
}

/** 统计分页/列表数据结构里的条数：数组直接取长度，{total}/{list} 取 total 或 list 长度 */
function countOf(data) {
    if (!data) return 0;
    if (isArray(data)) return data.length;
    if (typeof data.total === 'number') return data.total;
    if (isArray(data.list)) return data.list.length;
    if (isArray(data.records)) return data.records.length;
    return 0;
}

function must(cond, msg) {
    if (!cond) throw new Error(msg);
}

function skip(msg) {
    var e = new Error(msg || '已跳过');
    e.skipped = true;
    throw e;
}

/* ---------- UTF-8 编解码 ---------- */

function utf8Bytes(str) {
    var s = new ActiveXObject('ADODB.Stream');
    s.Type = 2;
    s.Charset = 'utf-8';
    s.Open();
    s.WriteText(str);
    s.Position = 0;
    s.Type = 1;
    var bytes = s.Read();
    s.Close();
    return bytes;
}

function decodeUtf8(bytes) {
    if (bytes === null || bytes === undefined) return '';
    var s = new ActiveXObject('ADODB.Stream');
    s.Type = 1;
    s.Open();
    s.Write(bytes);
    s.Position = 0;
    s.Type = 2;
    s.Charset = 'utf-8';
    var text = s.ReadText();
    s.Close();
    return text;
}

function parseJson(text) {
    if (!text) return null;
    try { if (typeof JSON !== 'undefined' && JSON.parse) return JSON.parse(text); } catch (e) { }
    try { return eval('(' + text + ')'); } catch (e2) { return null; }
}

/* ---------- HTTP ---------- */

function httpCall(method, path, body, useAuth) {
    var url = state.ctx.base + path;
    var xhr = new ActiveXObject('WinHttp.WinHttpRequest.5.1');
    xhr.Open(method, url, false);
    var to = parseInt(byId('timeout').value, 10);
    if (!to || to < 1000) to = 15000;
    xhr.SetTimeouts(to, to, to, to);
    xhr.SetRequestHeader('Accept', 'application/json');
    if (useAuth && state.ctx.token) xhr.SetRequestHeader('Authorization', state.ctx.token);
    if (body === null || body === undefined) {
        xhr.Send();
    } else {
        xhr.SetRequestHeader('Content-Type', 'application/json; charset=utf-8');
        xhr.Send(utf8Bytes(JSON.stringify(body)));
    }
    var record = {
        method: method,
        url: url,
        requestBody: (body === null || body === undefined) ? '' : JSON.stringify(body),
        status: xhr.Status,
        text: decodeUtf8(xhr.ResponseBody)
    };
    record.json = parseJson(record.text);
    LAST_HTTP = record;
    return record;
}

/** 标准 ResultBean：{code:200,message,obj} */
function expectOk(res, hint) {
    hint = hint || '';
    must(res.status === 200, 'HTTP ' + res.status + (hint ? '（' + hint + '）' : ''));
    must(res.json !== null, '响应不是 JSON：' + clip(res.text, 120));
    must(res.json.code === 200, '业务码 ' + res.json.code + '：' + (res.json.message || '无 message'));
    return res.json;
}

/** 裸对象/数组接口（帖子详情、用户信息、评论树、推荐/最新/热门等） */
function expectRaw(res) {
    must(res.status === 200, 'HTTP ' + res.status);
    must(res.json !== null && res.json !== undefined, '响应不是 JSON：' + clip(res.text, 120));
    return res.json;
}

/** 兼容两种结构：有 code 就校验 code，没有 code（裸 Map）则只看 HTTP */
function expectAnyOk(res) {
    must(res.status === 200, 'HTTP ' + res.status);
    must(res.json !== null && res.json !== undefined, '响应不是 JSON：' + clip(res.text, 120));
    if (typeof res.json.code !== 'undefined') {
        must(res.json.code === 200, '业务码 ' + res.json.code + '：' + (res.json.message || '无 message'));
    }
    return res.json;
}

/** 只读类用例应使用的帖子 id：生产安全模式优先用验收专用帖 */
function readArticleId() {
    if (state.ctx.prodSafe && state.ctx.testArticleId) return state.ctx.testArticleId;
    return state.ctx.articleId;
}

/** 写入用例是否被阻止；返回空串表示允许执行 */
function writeBlockedReason() {
    if (state.ctx.prodSafe) return '生产安全模式：不执行写入用例';
    if (!byId('writeMode').checked) return '未开启写入用例';
    return '';
}

/* ---------- UI 冒烟（无头浏览器；支持 Chrome / Edge / 360 极速 / 360 安全） ---------- */

function fileExists(path) {
    if (!path) return false;
    try { return new ActiveXObject('Scripting.FileSystemObject').FileExists(path); } catch (e) { return false; }
}

function expandEnv(path) {
    try { return new ActiveXObject('WScript.Shell').ExpandEnvironmentStrings(path); } catch (e) { return path; }
}

function regGetValue(key) {
    try {
        var v = new ActiveXObject('WScript.Shell').RegRead(key);
        if (!v) return '';
        return String(v).replace(/^"+|"+$/g, '');
    } catch (e) { return ''; }
}

/** 浏览器候选：注册表 App Paths 优先，其次常见安装目录（含 360 两种内核外壳） */
function browserCandidates() {
    return [
        {
            name: 'Chrome',
            exes: ['chrome.exe'],
            paths: [
                '%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe',
                '%ProgramFiles(x86)%\\Google\\Chrome\\Application\\chrome.exe',
                '%LOCALAPPDATA%\\Google\\Chrome\\Application\\chrome.exe'
            ]
        },
        {
            name: 'Edge',
            exes: ['msedge.exe'],
            paths: [
                '%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe',
                '%ProgramFiles%\\Microsoft\\Edge\\Application\\msedge.exe'
            ]
        },
        {
            name: '360极速浏览器',
            exes: ['360chrome.exe', '360chromeX.exe'],
            paths: [
                '%APPDATA%\\360Chrome\\Chrome\\Application\\360chrome.exe',
                '%APPDATA%\\360ChromeX\\Chrome\\Application\\360chrome.exe',
                '%ProgramFiles(x86)%\\360\\360Chrome\\Chrome\\Application\\360chrome.exe',
                '%ProgramFiles%\\360\\360Chrome\\Chrome\\Application\\360chrome.exe',
                '%ProgramFiles(x86)%\\360\\360ChromeX\\Chrome\\Application\\360chrome.exe',
                '%ProgramFiles%\\360\\360ChromeX\\Chrome\\Application\\360chrome.exe'
            ]
        },
        {
            name: '360安全浏览器',
            exes: ['360se.exe', '360se6.exe'],
            paths: [
                '%APPDATA%\\360se6\\Application\\360se.exe',
                '%ProgramFiles(x86)%\\360\\360se6\\Application\\360se.exe',
                '%ProgramFiles%\\360\\360se6\\Application\\360se.exe',
                '%LOCALAPPDATA%\\360se6\\Application\\360se.exe'
            ]
        }
    ];
}

/** 探测本机可用浏览器；返回 {name, path}，找不到返回 null */
function detectBrowser() {
    var hives = ['HKLM\\', 'HKCU\\'];
    var appPathRoots = [
        'SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\',
        'SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\App Paths\\'
    ];
    var list = browserCandidates();
    var i, j, k, exe, key, value;
    // 1) 注册表 App Paths
    for (i = 0; i < list.length; i++) {
        for (j = 0; j < list[i].exes.length; j++) {
            exe = list[i].exes[j];
            for (k = 0; k < hives.length; k++) {
                for (var r = 0; r < appPathRoots.length; r++) {
                    key = hives[k] + appPathRoots[r] + exe;
                    value = regGetValue(key);
                    if (value && fileExists(expandEnv(value))) {
                        return { name: list[i].name, path: expandEnv(value) };
                    }
                }
            }
        }
    }
    // 2) 常见安装目录
    for (i = 0; i < list.length; i++) {
        for (j = 0; j < list[i].paths.length; j++) {
            var p = expandEnv(list[i].paths[j]);
            if (fileExists(p)) return { name: list[i].name, path: p };
        }
    }
    return null;
}

/** 「探测」按钮：自动识别 Chrome / Edge / 360 并回填路径 */
function detectBrowserNow() {
    var found = detectBrowser();
    if (!found) {
        byId('browserHint').innerHTML = '<span class="fail">未探测到浏览器，请手动填写 chrome.exe / msedge.exe / 360chrome.exe 路径</span>';
        alert('未探测到 Chrome / Edge / 360 浏览器。\n可手动填写浏览器 exe 路径。');
        return;
    }
    byId('chromePath').value = found.path;
    byId('browserHint').innerHTML = '已探测到：<b>' + found.name + '</b>（' + found.path + '）';
}

function detectedBrowserName() {
    var p = trimStr(byId('chromePath').value);
    if (!p) return '未指定';
    var list = browserCandidates();
    for (var i = 0; i < list.length; i++) {
        for (var j = 0; j < list[i].paths.length; j++) {
            if (expandEnv(list[i].paths[j]).toLowerCase() === p.toLowerCase()) return list[i].name;
        }
        for (var k = 0; k < list[i].exes.length; k++) {
            if (p.toLowerCase().indexOf(list[i].exes[k].toLowerCase()) >= 0) return list[i].name;
        }
    }
    return '自定义浏览器';
}

function chromeExe() {
    var p = trimStr(byId('chromePath').value);
    if (p) return p;
    var found = detectBrowser();
    return found ? found.path : '';
}

function tempPath(name) {
    var sh = new ActiveXObject('WScript.Shell');
    return sh.ExpandEnvironmentStrings('%TEMP%') + '\\' + name;
}

function readUtf8File(path) {
    var s = new ActiveXObject('ADODB.Stream');
    s.Type = 2;
    s.Charset = 'utf-8';
    s.Open();
    s.LoadFromFile(path);
    var text = s.ReadText();
    s.Close();
    return text;
}

function deleteFile(path) {
    try {
        var fso = new ActiveXObject('Scripting.FileSystemObject');
        if (fso.FileExists(path)) fso.DeleteFile(path, true);
    } catch (e) { }
}

/** 用临时 .bat 执行命令，绕开 cmd /c 对含空格路径的引号解析问题 */
function runBatch(lines) {
    var bat = tempPath('bbs_e2e_cmd_' + (new Date().getTime()) + '.bat');
    var fso = new ActiveXObject('Scripting.FileSystemObject');
    var f = fso.CreateTextFile(bat, true, false);
    for (var i = 0; i < lines.length; i++) f.WriteLine(lines[i]);
    f.Close();
    var code = 1;
    try {
        var sh = new ActiveXObject('WScript.Shell');
        code = sh.Run('"' + bat + '"', 0, true);
    } finally {
        deleteFile(bat);
    }
    return code;
}

function frontUrl() {
    var u = trimStr(byId('frontUrl').value);
    return u.replace(/\/+$/, '');
}

/** 用无头浏览器 dump 指定 hash 路由的 DOM（--headless 失败时回退 --headless=new） */
function uiDump(hashPath) {
    var chrome = chromeExe();
    if (!chrome) skip('未探测到 Chrome / Edge / 360 浏览器，可手动填写 exe 路径');
    var url = frontUrl() + hashPath;
    var profile = tempPath('bbs_e2e_chrome_profile');
    var flags = ['--headless', '--headless=new'];
    for (var i = 0; i < flags.length; i++) {
        var out = tempPath('bbs_e2e_dom_' + (new Date().getTime()) + '_' + i + '.html');
        var line = '"' + chrome + '" ' + flags[i] + ' --disable-gpu --hide-scrollbars --no-first-run '
            + '--no-default-browser-check --user-data-dir="' + profile + '" '
            + '--virtual-time-budget=9000 --dump-dom "' + url + '" > "' + out + '" 2>nul';
        runBatch(['@echo off', line]);
        var html = '';
        try { html = readUtf8File(out); } catch (e) { html = ''; }
        deleteFile(out);
        if (html && html.length >= 200) return html;
    }
    throw new Error('页面未渲染出内容（' + url + '）；当前浏览器：' + detectedBrowserName()
        + '。请确认前端地址可访问；若为 360/IE 内核外壳，可改用 Chrome 109 或 Edge，并手动填写 exe 路径');
}

function uiCheck(hashPath, markers, label) {
    var html = uiDump(hashPath);
    var missing = [];
    for (var i = 0; i < markers.length; i++) {
        if (html.indexOf(markers[i]) < 0) missing.push(markers[i]);
    }
    if (missing.length > 0) {
        throw new Error(label + ' 缺少标记：' + missing.join('、'));
    }
    return label + ' 渲染正常（DOM ' + Math.round(html.length / 1024) + 'KB）';
}

function shotsDir() {
    var dir = scriptDir() + '\\e2e-shots';
    var fso = new ActiveXObject('Scripting.FileSystemObject');
    if (!fso.FolderExists(dir)) fso.CreateFolder(dir);
    return dir;
}

function uiShot(hashPath, name) {
    var chrome = chromeExe();
    if (!chrome) skip('未探测到 Chrome / Edge / 360 浏览器');
    var url = frontUrl() + hashPath;
    var file = shotsDir() + '\\' + fileStamp() + '-' + name + '.png';
    var profile = tempPath('bbs_e2e_chrome_profile');
    var flags = ['--headless', '--headless=new'];
    var fso = new ActiveXObject('Scripting.FileSystemObject');
    for (var i = 0; i < flags.length; i++) {
        var line = '"' + chrome + '" ' + flags[i] + ' --disable-gpu --hide-scrollbars --no-first-run '
            + '--no-default-browser-check --user-data-dir="' + profile + '" '
            + '--window-size=1440,1600 --virtual-time-budget=9000 --screenshot="' + file + '" "' + url + '" >nul 2>nul';
        runBatch(['@echo off', line]);
        if (fso.FileExists(file)) break;
    }
    if (!fso.FileExists(file)) throw new Error('截图未生成：' + name + '（当前浏览器：' + detectedBrowserName() + '）');
    var size = fso.GetFile(file).Size;
    if (size < 10000) throw new Error('截图疑似空白：' + name + '（' + size + ' 字节）');
    return name + ' 截图已保存（' + Math.round(size / 1024) + 'KB）';
}

/* ---------- 用例定义 ---------- */

function addTest(name, fn) { TESTS.push({ name: name, run: fn }); }

