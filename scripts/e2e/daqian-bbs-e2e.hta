/* ===== 负向自检（只读，不写库；用于验证判据能变红） ===== */

addTest('[负向] 错误 baseUrl 必须失败', function () {
    var failed = false;
    try {
        var xhr = new ActiveXObject('WinHttp.WinHttpRequest.5.1');
        xhr.Open('GET', 'http://127.0.0.1:1/bbs-server/common/featured/notices', false);
        xhr.SetTimeouts(3000, 3000, 3000, 3000);
        xhr.Send();
        failed = (xhr.Status !== 200);
    } catch (e) {
        failed = true;
    }
    if (!failed) throw new Error('错误地址竟然返回 200，判据不可靠');
    return '错误地址被识别为失败';
});

addTest('[负向] 错误断言必须被捕获', function () {
    var res = httpCall('GET', '/common/featured/notices', null, false);
    var json = parseJson(res.text);
    var caught = false;
    try {
        must(json && json.message === '__MUST_NOT_EXIST__', '断言不一致');
    } catch (e) {
        caught = true;
    }
    if (!caught) throw new Error('断言没有报错，判据可能是装饰品');
    return '错误断言已被判据捕获';
});

addTest('[负向] 未登录访问业务接口被拒绝', function () {
    // 显式不携带 token，验证鉴权判据
    var res = httpCall('GET', '/notification/unreadSummary?userId=1', null, false);
    var json = parseJson(res.text);
    if (!(json && json.code === 401)) {
        throw new Error('未登录竟然可以访问：' + clip(res.text, 80));
    }
    return '未登录返回 401';
});

/* ===== 写入（默认关闭） ===== */

addTest('[写入] 发帖→详情→删除', function () {
    var blocked = writeBlockedReason();
    if (blocked) skip(blocked);
    if (!state.ctx.user) skip('依赖登录用例');
    if (!state.ctx.labelId) skip('缺少标签 id');

    var labelId = state.ctx.testLabelId || state.ctx.labelId;
    var title = 'E2E自动验收-' + fileStamp() + '-' + Math.floor(Math.random() * 1000);
    var payload = {
        articleLabelId: labelId,
        articleAuthor: state.ctx.user.nickname || state.ctx.user.username || 'e2e',
        articleTitle: title,
        articleSummary: '自动化验收临时帖，脚本会自动删除',
        articleTypeId: 0,
        articleContent: 'E2E test content',
        articleContentHtml: '<p>E2E test content</p>',
        userId: state.ctx.user.id,
        articleCommunityId: 0,
        createTime: nowText(),
        files: [],
        isAnonymous: 0
    };
    expectOk(httpCall('POST', '/article/publish', payload, true));

    var foundId = findArticleByTitle(title);
    if (foundId === null) {
        throw new Error('发布成功但列表未查到该帖（可能被审核拦截），请人工确认是否残留：' + title);
    }
    expectOk(httpCall('POST', '/article/deleteArticleByArticleId', { articleId: foundId }, true));
    return '已创建并删除 articleId=' + foundId;
});

addTest('[写入] 点赞→取消', function () {
    var blocked = writeBlockedReason();
    if (blocked) skip(blocked);
    if (!state.ctx.user) skip('依赖登录用例');
    if (!state.ctx.articleId) skip('依赖帖子列表用例');
    expectOk(httpCall('POST', '/article/like', { articleId: state.ctx.articleId }, true));
    expectOk(httpCall('POST', '/article/like', { articleId: state.ctx.articleId }, true));
    return '已点赞并取消（articleId=' + state.ctx.articleId + '）';
});

addTest('[写入] 收藏→取消', function () {
    var blocked = writeBlockedReason();
    if (blocked) skip(blocked);
    if (!state.ctx.user) skip('依赖登录用例');
    if (!state.ctx.articleId) skip('依赖帖子列表用例');
    expectOk(httpCall('POST', '/article/favorite', { articleId: state.ctx.articleId }, true));
    expectOk(httpCall('POST', '/article/favorite', { articleId: state.ctx.articleId }, true));
    return '已收藏并取消（articleId=' + state.ctx.articleId + '）';
});

addTest('[写入] 评论→删除', function () {
    var blocked = writeBlockedReason();
    if (blocked) skip(blocked);
    if (!state.ctx.user) skip('依赖登录用例');
    if (!state.ctx.articleId) skip('依赖帖子列表用例');

    var content = 'E2E评论-' + fileStamp();
    expectOk(httpCall('PUT', '/comment/userComment', {
        commentContent: content,
        commentUserId: state.ctx.user.id,
        commentArticleId: state.ctx.articleId,
        isAnonymous: 0
    }, true));

    var commentId = findCommentId(content);
    if (commentId === null) {
        throw new Error('评论已提交但未查到记录，请人工确认是否残留：' + content);
    }
    expectOk(httpCall('POST', '/comment/deleteCommentById', { commentId: commentId }, true));
    return '已创建并删除 commentId=' + commentId;
});

/* ===== UI 冒烟（无头浏览器，只读公共页面） ===== */

addTest('[UI] 登录页渲染', function () {
    return uiCheck('/#/login', ['登录'], '登录页');
});

addTest('[UI] 论坛首页渲染', function () {
    return uiCheck('/#/forum', ['论坛', '精华帖'], '论坛首页');
});

addTest('[UI] 精华页渲染', function () {
    return uiCheck('/#/featured', ['精华'], '精华页');
});

addTest('[UI] 排行榜渲染', function () {
    return uiCheck('/#/points', ['排行榜'], '排行榜');
});

addTest('[UI] 页面截图', function () {
    if (!byId('shotEnabled').checked) skip('未开启截图');
    var notes = [];
    notes.push(uiShot('/#/forum', 'forum'));
    notes.push(uiShot('/#/featured', 'featured'));
    notes.push(uiShot('/#/points', 'points'));
    notes.push(uiShot('/#/login', 'login'));
    return notes.join('；');
});

/* ---------- 写入用例辅助：短轮询查找 ---------- */

function sleepBrief(ms) {
    var end = new Date().getTime() + ms;
    while (new Date().getTime() < end) { /* HTA 同步等待，仅用于短轮询 */ }
}

function findArticleByTitle(title) {
    var deadline = new Date().getTime() + 5000;
    while (new Date().getTime() < deadline) {
        var res = httpCall('POST', '/common/article/list', { keywords: title, page: 1, size: 5 }, true);
        if (res.json && res.json.obj && res.json.obj.list) {
            var list = res.json.obj.list;
            for (var i = 0; i < list.length; i++) {
                if (String(list[i].articleTitle) === title) return list[i].articleId;
            }
        }
        sleepBrief(600);
    }
    return null;
}

function findCommentId(content) {
    var deadline = new Date().getTime() + 5000;
    while (new Date().getTime() < deadline) {
        var res = httpCall('POST', '/common/comment/getCommentReply/' + state.ctx.articleId, null, true);
        var list = res.json;
        if (isArray(list)) {
            for (var i = 0; i < list.length; i++) {
                if (String(list[i].commentContent) === content) return list[i].commentId;
            }
        }
        sleepBrief(600);
    }
    return null;
}

/* ---------- 执行器 ---------- */

function renderTable() {
    var html = [];
    for (var i = 0; i < TESTS.length; i++) {
        var r = state.results[i] || { state: 'pending', cost: '', http: '', note: '' };
        var cls = r.state === 'ok' ? 'ok' : (r.state === 'fail' ? 'fail' : (r.state === 'skip' ? 'skip' : 'muted'));
        var label = r.state === 'ok' ? '通过' : (r.state === 'fail' ? '失败' : (r.state === 'skip' ? '跳过' : '待执行'));
        html.push('<tr class="row" id="row' + i + '" onclick="selectRow(' + i + ')">' +
            '<td class="col-no">' + (i + 1) + '</td>' +
            '<td class="col-name">' + escapeHtml(TESTS[i].name) + '</td>' +
            '<td class="col-state ' + cls + '">' + label + '</td>' +
            '<td class="col-cost">' + escapeHtml(r.cost) + '</td>' +
            '<td class="col-code">' + escapeHtml(r.http) + '</td>' +
            '<td>' + escapeHtml(r.note) + '</td>' +
            '</tr>');
    }
    byId('resultBody').innerHTML = html.join('');
}

function isMutationTest(i) {
    return TESTS[i].name.indexOf('[负向]') === 0;
}

function mutationStats() {
    var pass = 0, fail = 0, total = 0;
    for (var i = 0; i < TESTS.length; i++) {
        if (!isMutationTest(i)) continue;
        total++;
        var r = state.results[i];
        if (!r) continue;
        if (r.state === 'ok') pass++;
        else if (r.state === 'fail') fail++;
    }
    return { pass: pass, fail: fail, total: total };
}

function updateSummary() {
    var ok = 0, fail = 0, skipCount = 0, done = 0, total = 0;
    for (var i = 0; i < TESTS.length; i++) {
        if (isMutationTest(i)) continue;
        total++;
        var r = state.results[i];
        if (!r || !r.state || r.state === 'pending') continue;
        done++;
        if (r.state === 'ok') ok++;
        else if (r.state === 'fail') fail++;
        else skipCount++;
    }
    var mut = mutationStats();
    var text = '通过 ' + ok + ' · 失败 ' + fail + ' · 跳过 ' + skipCount + ' · 共 ' + total;
    text += '　｜　负向自检 ' + mut.pass + '/' + mut.total + '（不计入业务失败）';
    byId('summaryText').innerHTML = (fail > 0 || mut.fail > 0)
        ? '<span class="fail">' + text + '</span>' : text;
    var sub = '';
    if (state.startedAt) sub = '开始时间 ' + state.startedAt + (state.running ? ' · 运行中…' : ' · 已结束');
    byId('summarySub').innerHTML = sub ? '&nbsp;&nbsp;' + escapeHtml(sub) : '';
    var pct = total > 0 ? Math.round(done * 100 / total) : 0;
    byId('progressBar').style.width = pct + '%';
    byId('btnRun').disabled = state.running;
    byId('btnStop').disabled = !state.running;
}

function selectRow(i) {
    for (var k = 0; k < TESTS.length; k++) {
        var row = byId('row' + k);
        if (row && row.className.indexOf('sel') >= 0) row.className = 'row';
    }
    var cur = byId('row' + i);
    if (cur) cur.className = 'row sel';
    var r = state.results[i];
    if (!r) { byId('detail').innerHTML = '（尚未执行）'; return; }
    var lines = [];
    lines.push('用例：' + TESTS[i].name);
    lines.push('结果：' + (r.state === 'ok' ? '通过' : (r.state === 'fail' ? '失败' : '跳过')));
    if (r.note) lines.push('说明：' + r.note);
    if (r.http) lines.push('HTTP：' + r.http);
    if (r.method) lines.push(r.method + ' ' + r.requestUrl);
    if (r.requestBody) lines.push('请求体：' + r.requestBody);
    if (r.responseText) {
        lines.push('');
        lines.push('响应：');
        lines.push(clip(r.responseText, 4000));
    }
    byId('detail').innerHTML = escapeHtml(lines.join('\n'));
}

function startRun() {
    if (state.running) return;
    var base = trimStr(byId('baseUrl').value);
    if (!base) { alert('请填写服务地址'); return; }
    base = base.replace(/\/+$/, '');
    if (!/^https?:\/\//i.test(base)) { alert('服务地址需以 http:// 或 https:// 开头'); return; }

    state.running = true;
    state.stopRequested = false;
    state.results = [];
    state.startedAt = nowText();
    state.ctx = {
        base: base,
        token: '',
        user: null,
        articleId: null,
        labelId: null,
        categoryId: null,
        authorUserId: null,
        firstTitle: '',
        prodSafe: byId('prodSafe').checked,
        testArticleId: parseInt(trimStr(byId('testArticleId').value), 10) || null,
        testLabelId: parseInt(trimStr(byId('testLabelId').value), 10) || null
    };
    byId('detail').innerHTML = '（暂无）';
    renderTable();
    updateSummary();
    runNext(0);
}

function stopRun() {
    if (!state.running) return;
    state.stopRequested = true;
    byId('summarySub').innerHTML = '&nbsp;&nbsp;<span class="warn">正在停止…（等待当前用例结束）</span>';
}

function runNext(index) {
    if (!state.running) return;
    if (state.stopRequested) { finishRun(); return; }
    if (index >= TESTS.length) { finishRun(); return; }

    var test = TESTS[index];
    var started = new Date().getTime();
    var result = { state: 'pending', cost: '', http: '', note: '' };
    state.results[index] = result;
    renderTable();
    updateSummary();

    setTimeout(function () {
        LAST_HTTP = null;
        try {
            result.note = test.run() || '';
            result.state = 'ok';
        } catch (e) {
            if (e && e.skipped) {
                result.state = 'skip';
                result.note = e.message || '已跳过';
            } else {
                result.state = 'fail';
                result.note = (e && e.message) ? e.message : String(e);
            }
        }
        result.cost = (new Date().getTime() - started) + ' ms';
        if (LAST_HTTP) {
            result.http = String(LAST_HTTP.status);
            result.method = LAST_HTTP.method;
            result.requestUrl = LAST_HTTP.url;
            result.requestBody = LAST_HTTP.requestBody;
            result.responseText = LAST_HTTP.text;
        }
        renderTable();
        updateSummary();
        selectRow(index);
        runNext(index + 1);
    }, 25);
}

function finishRun() {
    state.running = false;
    state.stopRequested = false;
    updateSummary();
    var ok = 0, fail = 0;
    for (var i = 0; i < TESTS.length; i++) {
        if (isMutationTest(i)) continue;
        if (state.results[i] && state.results[i].state === 'ok') ok++;
        if (state.results[i] && state.results[i].state === 'fail') fail++;
    }
    var mut = mutationStats();
    if (fail > 0 || mut.fail > 0) {
        var msg = '验收结束：业务通过 ' + ok + ' 个，失败 ' + fail + ' 个。';
        if (mut.fail > 0) msg += '\n负向自检未通过：' + mut.pass + '/' + mut.total + '，判据本身需要先修。';
        alert(msg + '\n请查看失败用例的说明与响应明细。');
    }
}

/* ---------- 报告 ---------- */

function buildReport() {
    var lines = [];
    lines.push('大千智荟论坛 · 部署验收 E2E 报告');
    lines.push('生成时间：' + nowText());
    lines.push('服务地址：' + state.ctx.base);
    lines.push('验收账号：' + (state.ctx.user ? (state.ctx.user.nickname || state.ctx.user.username) : trimStr(byId('username').value) || '(未填写)'));
    lines.push('运行模式：' + (state.ctx.prodSafe ? '生产安全（只读）' : '完整') + '；写入用例：' + (byId('writeMode').checked && !state.ctx.prodSafe ? '已开启' : '未开启'));
    lines.push('');
    var ok = 0, fail = 0, skipCount = 0;
    for (var i = 0; i < TESTS.length; i++) {
        var r = state.results[i] || { state: 'pending', note: '未执行', cost: '', http: '' };
        var mutation = isMutationTest(i);
        var label;
        if (mutation) {
            label = r.state === 'ok' ? 'MUT-PASS' : (r.state === 'fail' ? 'MUT-FAIL' : 'MUT-SKIP');
        } else {
            label = r.state === 'ok' ? 'PASS' : (r.state === 'fail' ? 'FAIL' : (r.state === 'skip' ? 'SKIP' : 'TODO'));
            if (r.state === 'ok') ok++;
            if (r.state === 'fail') fail++;
            if (r.state === 'skip') skipCount++;
        }
        lines.push('[' + label + '] ' + (i + 1) + '. ' + TESTS[i].name + '  (' + (r.cost || '-') + ')');
        if (r.note) lines.push('      说明：' + r.note);
        if (r.method) lines.push('      请求：' + r.method + ' ' + r.requestUrl);
        if (r.responseText) lines.push('      响应：' + clip(String(r.responseText).replace(/\s+/g, ' '), 400));
        if (r.state === 'fail') lines.push('');
    }
    var mut = mutationStats();
    lines.push('');
    lines.push('汇总：通过 ' + ok + ' / 失败 ' + fail + ' / 跳过 ' + skipCount + ' / 共 ' +
        (ok + fail + skipCount));
    lines.push('负向自检：' + mut.pass + '/' + mut.total + ' 通过（不计入业务失败；失败 ' + mut.fail + ' 项）');
    return lines.join('\r\n');
}

function scriptDir() {
    var p;
    try { p = unescape(window.location.pathname); } catch (e) { p = String(window.location.pathname); }
    if (p.charAt(0) === '/' && p.charAt(2) === ':') p = p.substring(1);
    p = p.replace(/\//g, '\\');
    var i = p.lastIndexOf('\\');
    return i > 0 ? p.substring(0, i) : 'C:\\';
}

function saveReport() {
    var path = scriptDir() + '\\e2e-report-' + fileStamp() + '.txt';
    var text = buildReport();
    try {
        var s = new ActiveXObject('ADODB.Stream');
        s.Type = 2;
        s.Charset = 'utf-8';
        s.Open();
        s.WriteText(text);
        s.SaveToFile(path, 2);
        s.Close();
    } catch (e) {
        alert('保存失败：' + e.message);
        return;
    }
    alert('报告已保存：\n' + path);
}

/* ---------- 初始化 ---------- */

function init() {
    try { window.resizeTo(1140, 830); } catch (e) { }
    try { window.moveTo(60, 40); } catch (e) { }
    try {
        if (!trimStr(byId('chromePath').value)) {
            var found = detectBrowser();
            if (found) {
                byId('chromePath').value = found.path;
                byId('browserHint').innerHTML = '已探测到：<b>' + found.name + '</b>（' + found.path + '）';
            }
        }
    } catch (e2) { }
    renderTable();
    updateSummary();
    document.title = '大千智荟论坛 · 部署验收 E2E';
}

init();
</script>
</body>
</html>



