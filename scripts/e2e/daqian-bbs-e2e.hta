addTest('[账号] 登录获取 Token', function () {
    var u = trimStr(byId('username').value);
    var p = byId('password').value;
    if (!u || !p) skip('未填写验收账号/密码');
    var json = expectOk(httpCall('POST', '/common/login', { username: u, password: p, channel: '01' }, false));
    must(json.obj, '登录响应缺少 obj');
    must(json.obj.token, '登录响应缺少 token');
    must(json.obj.user && json.obj.user.id, '登录响应缺少 user.id');
    state.ctx.token = String(json.obj.tokenHead || '') + String(json.obj.token);
    state.ctx.user = json.obj.user;
    var note = '登录成功：' + (json.obj.user.nickname || json.obj.user.username || '') + '（id=' + json.obj.user.id + '）';
    if (state.ctx.prodSafe && json.obj.user.isTestAccount !== 1) {
        note += '；提示：生产环境建议使用 is_test_account=1 的专用验收账号';
