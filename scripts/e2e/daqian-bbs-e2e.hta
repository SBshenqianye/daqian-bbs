<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>大千智荟论坛 · 部署验收 E2E（Win7 HTA）</title>
<hta:application id="bbsE2E"
    applicationname="bbs-e2e"
    border="thin"
    caption="yes"
    icon="mshta.exe"
    maximizebutton="no"
    minimizebutton="yes"
    scroll="no"
    singleinstance="yes" />
<style type="text/css">
    html, body { margin: 0; padding: 0; background: #f4f6fa; color: #181c23;
        font-family: "Microsoft YaHei", "微软雅黑", Tahoma, Arial, sans-serif; font-size: 12.5px; }
    a { color: #0052d9; }
    .wrap { padding: 14px 16px 10px 16px; }
    .title { font-size: 17px; font-weight: bold; color: #0b2b66; }
    .title span { font-size: 11px; font-weight: normal; color: #7b8194; margin-left: 8px; }
    .card { background: #fff; border: 1px solid #dbe0ea; border-radius: 6px; padding: 10px 12px; margin-top: 10px; }
    .label { color: #5b6475; }
    input[type=text], input[type=password] {
        border: 1px solid #c9cfdb; border-radius: 4px; padding: 3px 6px; height: 20px;
        font-family: "Microsoft YaHei", Tahoma, Arial, sans-serif; font-size: 12.5px; }
    input[type=text]:focus, input[type=password]:focus { border-color: #7ba3ee; outline: none; }
    .btn { border: 1px solid #c3cbd9; background: #fff; color: #1f2a3d; border-radius: 4px;
        padding: 4px 12px; height: 26px; cursor: pointer; font-size: 12.5px;
        font-family: "Microsoft YaHei", Tahoma, Arial, sans-serif; }
    .btn:hover { border-color: #0052d9; color: #0052d9; }
    .btn-primary { background: #0052d9; border-color: #0052d9; color: #fff; }
    .btn-primary:hover { color: #fff; opacity: .9; }
    .btn[disabled] { color: #9aa2b1; border-color: #dfe3ea; background: #f5f6f8; cursor: default; }
    .summary { margin-top: 10px; padding: 8px 12px; background: #fff; border: 1px solid #dbe0ea; border-radius: 6px; }
    .summary b { font-size: 13.5px; }
    .ok { color: #0a7d33; }
    .fail { color: #c62828; }
    .skip { color: #8a6d1d; }
    .muted { color: #7b8194; }
    .bar { height: 6px; background: #e8ebf2; border-radius: 3px; margin-top: 7px; overflow: hidden; }
    .bar i { display: block; height: 6px; width: 0; background: #0052d9; }
    table.grid { width: 100%; border-collapse: collapse; margin-top: 10px; background: #fff; }
    table.grid th, table.grid td { border-bottom: 1px solid #eef1f6; padding: 5px 7px; text-align: left;
        vertical-align: top; font-size: 12.5px; }
    table.grid th { background: #f8fafd; color: #5b6475; font-weight: normal; border-bottom: 1px solid #dfe4ee; }
    table.grid tr.row { cursor: pointer; }
    table.grid tr.row:hover td { background: #f6f9ff; }
    table.grid tr.sel td { background: #eef4ff; }
    td.col-no { width: 34px; color: #8a91a1; }
    td.col-name { width: 190px; }
    td.col-state { width: 62px; }
    td.col-cost { width: 70px; color: #7b8194; }
    td.col-code { width: 56px; color: #7b8194; }
    .detail { margin-top: 10px; }
    .detail pre { margin: 6px 0 0 0; padding: 8px; background: #0f172a; color: #d7e2f5; border-radius: 5px;
        height: 150px; overflow: auto; font-family: Consolas, "Courier New", monospace; font-size: 11.5px;
        white-space: pre-wrap; word-wrap: break-word; }
    .hint { color: #7b8194; font-size: 11.5px; margin-top: 4px; }
    .warn { color: #a8620a; }
    .foot { margin-top: 8px; color: #8a91a1; font-size: 11px; }
</style>
</head>
<body>
<div class="wrap">
    <div class="title">大千智荟论坛 · 部署验收 E2E
        <span>单文件 HTA · 适用于 Windows 7（自带 mshta）</span>
    </div>

    <div class="card">
        <table cellspacing="0" cellpadding="0" border="0">
            <tr>
                <td class="label" width="72">服务地址</td>
                <td><input type="text" id="baseUrl" style="width:330px" value="http://127.0.0.1:9083/bbs-server"></td>
                <td class="label" width="70" align="right">超时(ms)</td>
                <td><input type="text" id="timeout" style="width:70px" value="15000"></td>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td class="label" style="padding-top:6px">验收账号</td>
                <td style="padding-top:6px"><input type="text" id="username" style="width:150px" value="">&nbsp;
                    <span class="label">密码</span>&nbsp;
                    <input type="password" id="password" style="width:150px" value=""></td>
                <td colspan="2" align="right" style="padding-top:6px">
                    <input type="checkbox" id="writeMode"> <span class="warn">包含写入用例（发帖→删除）</span>
                </td>
                <td>&nbsp;</td>
            </tr>
        </table>
        <div class="hint">只读用例不会修改数据；勾选写入用例会在生产库创建一篇临时帖并立即尝试删除，请谨慎。</div>
    </div>

    <div style="margin-top:10px">
        <button class="btn btn-primary" id="btnRun" onclick="startRun()">开始验收</button>
        <button class="btn" id="btnStop" onclick="stopRun()" disabled>停止</button>
        <button class="btn" id="btnSave" onclick="saveReport()">保存报告</button>
        <button class="btn" onclick="window.close()">关闭</button>
    </div>

    <div class="summary">
        <b id="summaryText">尚未开始</b>
        <span class="muted" id="summarySub"></span>
        <div class="bar"><i id="progressBar"></i></div>
    </div>

    <table class="grid" id="resultTable" cellspacing="0" cellpadding="0">
        <thead>
        <tr>
            <th class="col-no">#</th>
            <th>用例</th>
            <th class="col-state">结果</th>
            <th class="col-cost">耗时</th>
            <th class="col-code">HTTP</th>
            <th>说明</th>
        </tr>
        </thead>
        <tbody id="resultBody"></tbody>
    </table>

    <div class="detail card" style="padding:8px 12px">
        <div class="label">明细（点击上面任意一行查看请求与响应）</div>
        <pre id="detail">（暂无）</pre>
    </div>

    <div class="foot">报告保存到本文件所在目录；仅使用系统自带组件（mshta + WinHttp），无需安装运行库。</div>
</div>

<script type="text/javascript">
/* ============================================================
 * 大千智荟论坛 · 部署验收 E2E（Windows 7 单文件 HTA）
 * 说明：
 *  - 纯 ES5 + ActiveX（WinHttp / ADODB），不依赖任何外部库；
 *  - 只读用例覆盖：服务可达、登录、用户、帖子、评论、精华、排行、通知、举报查重；
 *  - 写入用例默认关闭，开启后创建临时帖并尝试删除。
 * ============================================================ */

var TESTS = [];
var state = {
    running: false,
    stopRequested: false,
    results: [],
    startedAt: null,
    ctx: { base: '', token: '', user: null, articleId: null, labelId: null }
};

/* ---------- 通用工具 ---------- */

function byId(id) { return document.getElementById(id); }

function trimStr(s) {
    if (s === null || s === undefined) return '';
    s = String(s);
    return s.replace(/^\s+|\s+$/g, '');
}

function pad2(n) { return n < 10 ? '0' + n : String(n); }

function nowText() {
    var d = new Date();
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()) + ' ' +
        pad2(d.getHours()) + ':' + pad2(d.getMinutes()) + ':' + pad2(d.getSeconds());
}

function fileStamp() {
    var d = new Date();
    return '' + d.getFullYear() + pad2(d.getMonth() + 1) + pad2(d.getDate()) + '-' +
        pad2(d.getHours()) + pad2(d.getMinutes()) + pad2(d.getSeconds());
}

function escapeHtml(s) {
    s = (s === null || s === undefined) ? '' : String(s);
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function clip(s, n) {
    s = (s === null || s === undefined) ? '' : String(s);
    return s.length > n ? s.substring(0, n) + ' ...' : s;
}

function must(cond, msg) {
    if (!cond) throw new Error(msg);
}

function skip(msg) {
    var e = new Error(msg || '已跳过');
    e.skipped = true;
    throw e;
}

/* ---------- UTF-8 编解码 ---------- */

function utf8Bytes(str) {
    var s = new ActiveXObject('ADODB.Stream');
    s.Type = 2;
    s.Charset = 'utf-8';
    s.Open();
    s.WriteText(str);
    s.Position = 0;
    s.Type = 1;
    var bytes = s.Read();
    s.Close();
    return bytes;
}

function decodeUtf8(bytes) {
    if (bytes === null || bytes === undefined) return '';
    var s = new ActiveXObject('ADODB.Stream');
    s.Type = 1;
    s.Open();
    s.Write(bytes);
    s.Position = 0;
    s.Type = 2;
    s.Charset = 'utf-8';
    var text = s.ReadText();
    s.Close();
    return text;
}

function parseJson(text) {
    if (!text) return null;
    try { if (typeof JSON !== 'undefined' && JSON.parse) return JSON.parse(text); } catch (e) { }
    try { return eval('(' + text + ')'); } catch (e2) { return null; }
}

/* ---------- HTTP ---------- */

function httpCall(method, path, body, useAuth) {
    var url = state.ctx.base + path;
    var xhr = new ActiveXObject('WinHttp.WinHttpRequest.5.1');
    xhr.Open(method, url, false);
    var to = parseInt(byId('timeout').value, 10);
    if (!to || to < 1000) to = 15000;
    xhr.SetTimeouts(to, to, to, to);
    xhr.SetRequestHeader('Accept', 'application/json');
    if (useAuth && state.ctx.token) xhr.SetRequestHeader('Authorization', state.ctx.token);
    if (body === null || body === undefined) {
        xhr.Send();
    } else {
        xhr.SetRequestHeader('Content-Type', 'application/json; charset=utf-8');
        xhr.Send(utf8Bytes(JSON.stringify(body)));
    }
    var record = {
        method: method,
        url: url,
        requestBody: (body === null || body === undefined) ? '' : JSON.stringify(body),
        status: xhr.Status,
        text: decodeUtf8(xhr.ResponseBody)
    };
    record.json = parseJson(record.text);
    LAST_HTTP = record;
    return record;
}

var LAST_HTTP = null;

function expectOk(res, hint) {
    hint = hint || '';
    must(res.status === 200, 'HTTP ' + res.status + (hint ? '（' + hint + '）' : ''));
    must(res.json !== null, '响应不是 JSON：' + clip(res.text, 120));
    must(res.json.code === 200, '业务码 ' + res.json.code + '：' + (res.json.message || '无 message'));
    return res.json;
}

/* 部分接口（帖子详情、用户信息、评论树）直接返回裸对象/数组，没有 code 包装 */
function expectRaw(res) {
    must(res.status === 200, 'HTTP ' + res.status);
    must(res.json !== null && res.json !== undefined, '响应不是 JSON：' + clip(res.text, 120));
    return res.json;
}

/* ---------- 用例定义 ---------- */

function addTest(name, fn) { TESTS.push({ name: name, run: fn }); }

addTest('服务可达性', function () {
    var res = httpCall('GET', '/common/featured/notices', null, false);
    expectOk(res);
    must(res.json.obj !== null && res.json.obj !== undefined, 'obj 为空');
    return 'GET /common/featured/notices 正常';
});

addTest('登录获取 Token', function () {
    var u = trimStr(byId('username').value);
    var p = byId('password').value;
    if (!u || !p) skip('未填写验收账号/密码');
    var res = httpCall('POST', '/common/login', { username: u, password: p, channel: '01' }, false);
    var json = expectOk(res);
    must(json.obj, '登录响应缺少 obj');
    must(json.obj.token, '登录响应缺少 token');
    must(json.obj.user && json.obj.user.id, '登录响应缺少 user.id');
    state.ctx.token = String(json.obj.tokenHead || '') + String(json.obj.token);
    state.ctx.user = json.obj.user;
    var nick = json.obj.user.nickname || json.obj.user.username || '';
    return '登录成功：' + nick + '（id=' + json.obj.user.id + '）';
});

addTest('用户信息', function () {
    if (!state.ctx.user) skip('依赖登录用例');
    var res = httpCall('POST', '/common/user/getUserinfoById/' + state.ctx.user.id, null, false);
    var user = expectRaw(res);
    must(user && user.id, '用户信息缺少 id');
    return '用户：' + (user.nickname || user.username || '-') + '（id=' + user.id + '）';
});

addTest('帖子列表', function () {
    var res = httpCall('POST', '/common/article/list', { page: 1, size: 10 }, false);
    var json = expectOk(res);
    var list = (json.obj && json.obj.list) || [];
    must(list.length > 0, '列表为空，无法继续验证帖子相关用例');
    state.ctx.articleId = list[0].articleId;
    state.ctx.labelId = list[0].articleLabelId;
    return '共 ' + (json.obj.total || list.length) + ' 条，取 articleId=' + state.ctx.articleId;
});

addTest('帖子详情', function () {
    if (!state.ctx.articleId) skip('依赖帖子列表用例');
    var res = httpCall('POST', '/common/article/getArticleById/articleId/' + state.ctx.articleId, null, false);
    var article = expectRaw(res);
    must(article && article.articleTitle, '详情缺少标题');
    var note = '标题：' + clip(article.articleTitle, 32);
    if (article.isFeatured === 1 || article.isFeatured === '1') note += '；精华帖';
    if (typeof article.selfAuthored === 'boolean') note += '；selfAuthored=' + article.selfAuthored;
    return note;
});

addTest('帖子状态', function () {
    if (!state.ctx.articleId) skip('依赖帖子列表用例');
    var res = httpCall('POST', '/common/article/getArticleStatus/articleId/' + state.ctx.articleId, null, false);
    var json = expectOk(res);
    var s = String(json.obj || '');
    must(s === 'NORMAL' || s === 'DELETED' || s === 'NOT_EXIST', '未知状态：' + s);
    return '状态：' + s;
});

addTest('评论与回复', function () {
    if (!state.ctx.articleId) skip('依赖帖子列表用例');
    var res = httpCall('POST', '/common/comment/getCommentReply/' + state.ctx.articleId, null, false);
    var list = expectRaw(res);
    must(list && typeof list.length === 'number', '返回结构不是数组');
    var replyCount = 0;
    for (var i = 0; i < list.length; i++) {
        replyCount += (list[i].children ? list[i].children.length : 0);
    }
    return '评论 ' + list.length + ' 条，回复 ' + replyCount + ' 条';
});

addTest('精华展示位', function () {
    var res = httpCall('GET', '/common/featured/showcase', null, false);
    var json = expectOk(res);
    var list = json.obj || [];
    must(typeof list.length === 'number', '返回结构不是数组');
    var hasContent = 0;
    for (var i = 0; i < list.length; i++) {
        if (!list[i].articleId) throw new Error('第 ' + (i + 1) + ' 条缺少 articleId');
        if (list[i].content) hasContent++;
    }
    var note = '展示 ' + list.length + ' 条';
    if (list.length > 0 && hasContent === 0) {
        note += '（提示：未返回 content 字段，封面兜底将退化为摘要）';
    }
    return note;
});

addTest('精华公示', function () {
    var res = httpCall('GET', '/common/featured/notices', null, false);
    var json = expectOk(res);
    must(json.obj && typeof json.obj.length === 'number', 'obj 不是数组');
    return '公示 ' + json.obj.length + ' 条';
});

addTest('排行榜分类', function () {
    var res = httpCall('GET', '/common/ranking/categories', null, false);
    var json = expectOk(res);
    var list = json.obj || [];
    must(list.length > 0, '分类为空（迁移种子可能未执行）');
    state.ctx.categoryId = list[0].id;
    var names = [];
    for (var i = 0; i < list.length && i < 5; i++) names.push(list[i].categoryName);
    return list.length + ' 个分类：' + names.join('、');
});

addTest('组织排行榜', function () {
    if (!state.ctx.categoryId) skip('依赖排行榜分类用例');
    var res = httpCall('POST', '/common/ranking/org', { categoryId: state.ctx.categoryId }, false);
    var json = expectOk(res);
    var list = json.obj || [];
    must(typeof list.length === 'number', '返回结构不是数组');
    return '分类 ' + state.ctx.categoryId + ' 共 ' + list.length + ' 个组织上榜';
});

addTest('积分排行榜', function () {
    var res = httpCall('POST', '/common/pointsRank', { rankType: '02' }, false);
    var json = expectOk(res);
    var list = json.obj || [];
    must(typeof list.length === 'number', '返回结构不是数组');
    return '累计榜 ' + list.length + ' 个单位';
});

addTest('未读消息汇总', function () {
    if (!state.ctx.user) skip('依赖登录用例');
    var res = httpCall('GET', '/notification/unreadSummary?userId=' + state.ctx.user.id, null, true);
    var json = expectOk(res);
    must(json.obj, 'obj 为空');
    must(typeof json.obj.total === 'number', 'obj.total 不是数字');
    return '未读总数 ' + json.obj.total + '（互动 ' +
        ((json.obj.byCategory && json.obj.byCategory.interaction) || 0) + ' / 系统 ' +
        ((json.obj.byCategory && json.obj.byCategory.system) || 0) + '）';
});

addTest('举报查重接口', function () {
    if (!state.ctx.user) skip('依赖登录用例');
    if (!state.ctx.articleId) skip('依赖帖子列表用例');
    var res = httpCall('POST', '/user/report/check', {
        reporterId: state.ctx.user.id,
        targetType: 'article',
        targetId: state.ctx.articleId
    }, true);
    var json = expectOk(res);
    return '查重返回：' + clip(JSON.stringify(json.obj), 80);
});

addTest('【写入】发帖与删除', function () {
    if (!byId('writeMode').checked) skip('未开启写入用例');
    if (!state.ctx.user) skip('依赖登录用例');
    if (!state.ctx.labelId) skip('依赖帖子列表用例（取标签）');

    var title = 'E2E自动验收-' + fileStamp() + '-' + Math.floor(Math.random() * 1000);
    var payload = {
        articleLabelId: state.ctx.labelId,
        articleAuthor: state.ctx.user.nickname || state.ctx.user.username || 'e2e',
        articleTitle: title,
        articleSummary: '自动化验收临时帖，脚本会自动尝试删除',
        articleTypeId: 0,
        articleContent: 'E2E test content',
        articleContentHtml: '<p>E2E test content</p>',
        userId: state.ctx.user.id,
        articleCommunityId: 0,
        createTime: nowText(),
        files: [],
        isAnonymous: 0
    };
    var res = httpCall('POST', '/article/publish', payload, true);
    expectOk(res);

    // 通过列表按标题找回 articleId（发布响应不保证返回 id，且可能处于待审状态）
    var foundId = null;
    var deadline = new Date().getTime() + 5000;
    while (new Date().getTime() < deadline && foundId === null) {
        var listRes = httpCall('POST', '/common/article/list', { keywords: title, page: 1, size: 5 }, true);
        if (listRes.json && listRes.json.obj && listRes.json.obj.list) {
            var list = listRes.json.obj.list;
            for (var i = 0; i < list.length; i++) {
                if (String(list[i].articleTitle) === title) { foundId = list[i].articleId; break; }
            }
        }
        if (foundId === null) sleepBrief(600);
    }
    if (foundId === null) {
        throw new Error('发布成功但列表未查到该帖（可能被审核拦截），请人工确认是否残留：' + title);
    }

    var delRes = httpCall('POST', '/article/deleteArticleByArticleId', { articleId: foundId }, true);
    expectOk(delRes);
    return '已创建并删除 articleId=' + foundId;
});

function sleepBrief(ms) {
    var end = new Date().getTime() + ms;
    while (new Date().getTime() < end) { /* HTA 同步等待，仅用于短轮询 */ }
}

/* ---------- 执行器 ---------- */

function renderTable() {
    var html = [];
    for (var i = 0; i < TESTS.length; i++) {
        var r = state.results[i] || { state: 'pending', cost: '', http: '', note: '' };
        var cls = r.state === 'ok' ? 'ok' : (r.state === 'fail' ? 'fail' : (r.state === 'skip' ? 'skip' : 'muted'));
        var label = r.state === 'ok' ? '通过' : (r.state === 'fail' ? '失败' : (r.state === 'skip' ? '跳过' : '待执行'));
        html.push('<tr class="row" id="row' + i + '" onclick="selectRow(' + i + ')">' +
            '<td class="col-no">' + (i + 1) + '</td>' +
            '<td class="col-name">' + escapeHtml(TESTS[i].name) + '</td>' +
            '<td class="col-state ' + cls + '">' + label + '</td>' +
            '<td class="col-cost">' + escapeHtml(r.cost) + '</td>' +
            '<td class="col-code">' + escapeHtml(r.http) + '</td>' +
            '<td>' + escapeHtml(r.note) + '</td>' +
            '</tr>');
    }
    byId('resultBody').innerHTML = html.join('');
}

function updateSummary() {
    var ok = 0, fail = 0, skipCount = 0, done = 0;
    for (var i = 0; i < state.results.length; i++) {
        var s = state.results[i].state;
        if (!s || s === 'pending') continue;
        done++;
        if (s === 'ok') ok++;
        else if (s === 'fail') fail++;
        else skipCount++;
    }
    var total = TESTS.length;
    var text = '通过 ' + ok + ' · 失败 ' + fail + ' · 跳过 ' + skipCount + ' · 共 ' + total;
    byId('summaryText').innerHTML = fail > 0 ? '<span class="fail">' + text + '</span>' : text;
    var sub = '';
    if (state.startedAt) sub = '开始时间 ' + state.startedAt + (state.running ? ' · 运行中…' : ' · 已结束');
    byId('summarySub').innerHTML = sub ? '&nbsp;&nbsp;' + escapeHtml(sub) : '';
    var pct = total > 0 ? Math.round(done * 100 / total) : 0;
    byId('progressBar').style.width = pct + '%';
    byId('btnRun').disabled = state.running;
    byId('btnStop').disabled = !state.running;
}

function selectRow(i) {
    for (var k = 0; k < TESTS.length; k++) {
        var row = byId('row' + k);
        if (row && row.className.indexOf('sel') >= 0) row.className = 'row';
    }
    var cur = byId('row' + i);
    if (cur) cur.className = 'row sel';
    var r = state.results[i];
    if (!r) { byId('detail').innerHTML = '（尚未执行）'; return; }
    var lines = [];
    lines.push('用例：' + TESTS[i].name);
    lines.push('结果：' + (r.state === 'ok' ? '通过' : r.state === 'fail' ? '失败' : '跳过'));
    if (r.note) lines.push('说明：' + r.note);
    if (r.http) lines.push('HTTP：' + r.http);
    if (r.requestUrl) lines.push('');
    if (r.method) lines.push(r.method + ' ' + r.requestUrl);
    if (r.requestBody) lines.push('请求体：' + r.requestBody);
    if (r.responseText) {
        lines.push('');
        lines.push('响应：');
        lines.push(clip(r.responseText, 4000));
    }
    byId('detail').innerHTML = escapeHtml(lines.join('\n'));
}

function startRun() {
    if (state.running) return;
    var base = trimStr(byId('baseUrl').value);
    if (!base) { alert('请填写服务地址'); return; }
    base = base.replace(/\/+$/, '');
    if (!/^https?:\/\//i.test(base)) { alert('服务地址需以 http:// 或 https:// 开头'); return; }

    state.running = true;
    state.stopRequested = false;
    state.results = [];
    state.startedAt = nowText();
    state.ctx = { base: base, token: '', user: null, articleId: null, labelId: null, categoryId: null };
    byId('detail').innerHTML = '（暂无）';
    renderTable();
    updateSummary();
    runNext(0);
}

function stopRun() {
    if (!state.running) return;
    state.stopRequested = true;
    byId('summarySub').innerHTML = '&nbsp;&nbsp;<span class="warn">正在停止…（等待当前用例结束）</span>';
}

function runNext(index) {
    if (!state.running) return;
    if (state.stopRequested) { finishRun(); return; }
    if (index >= TESTS.length) { finishRun(); return; }

    var test = TESTS[index];
    var started = new Date().getTime();
    var result = { state: 'pending', cost: '', http: '', note: '' };
    state.results[index] = result;
    renderTable();
    updateSummary();

    // 让界面先重绘，再执行同步 HTTP
    setTimeout(function () {
        LAST_HTTP = null;
        try {
            result.note = test.run() || '';
            result.state = 'ok';
        } catch (e) {
            if (e && e.skipped) {
                result.state = 'skip';
                result.note = e.message || '已跳过';
            } else {
                result.state = 'fail';
                result.note = (e && e.message) ? e.message : String(e);
            }
        }
        result.cost = (new Date().getTime() - started) + ' ms';
        if (LAST_HTTP) {
            result.http = String(LAST_HTTP.status);
            result.method = LAST_HTTP.method;
            result.requestUrl = LAST_HTTP.url;
            result.requestBody = LAST_HTTP.requestBody;
            result.responseText = LAST_HTTP.text;
        }
        renderTable();
        updateSummary();
        selectRow(index);
        runNext(index + 1);
    }, 30);
}

function finishRun() {
    state.running = false;
    state.stopRequested = false;
    updateSummary();
    var ok = 0, fail = 0;
    for (var i = 0; i < state.results.length; i++) {
        if (state.results[i].state === 'ok') ok++;
        if (state.results[i].state === 'fail') fail++;
    }
    if (fail > 0) {
        alert('验收结束：通过 ' + ok + ' 个，失败 ' + fail + ' 个。\n请查看失败用例的说明与响应明细。');
    }
}

/* ---------- 报告 ---------- */

function buildReport() {
    var lines = [];
    lines.push('大千智荟论坛 · 部署验收 E2E 报告');
    lines.push('生成时间：' + nowText());
    lines.push('服务地址：' + state.ctx.base);
    lines.push('验收账号：' + (state.ctx.user ? (state.ctx.user.nickname || state.ctx.user.username) : trimStr(byId('username').value) || '(未填写)'));
    lines.push('写入用例：' + (byId('writeMode').checked ? '已开启' : '未开启'));
    lines.push('');
    var ok = 0, fail = 0, skipCount = 0;
    for (var i = 0; i < TESTS.length; i++) {
        var r = state.results[i] || { state: 'pending', note: '未执行', cost: '', http: '' };
        var label = r.state === 'ok' ? 'PASS' : (r.state === 'fail' ? 'FAIL' : (r.state === 'skip' ? 'SKIP' : 'TODO'));
        if (r.state === 'ok') ok++;
        if (r.state === 'fail') fail++;
        if (r.state === 'skip') skipCount++;
        lines.push('[' + label + '] ' + (i + 1) + '. ' + TESTS[i].name + '  (' + (r.cost || '-') + ')');
        if (r.note) lines.push('      说明：' + r.note);
        if (r.method) lines.push('      请求：' + r.method + ' ' + r.requestUrl);
        if (r.responseText) lines.push('      响应：' + clip(String(r.responseText).replace(/\s+/g, ' '), 400));
        if (r.state === 'fail') lines.push('');
    }
    lines.push('');
    lines.push('汇总：通过 ' + ok + ' / 失败 ' + fail + ' / 跳过 ' + skipCount + ' / 共 ' + TESTS.length);
    return lines.join('\r\n');
}

function scriptDir() {
    var p;
    try { p = unescape(window.location.pathname); } catch (e) { p = String(window.location.pathname); }
    if (p.charAt(0) === '/' && p.charAt(2) === ':') p = p.substring(1);
    p = p.replace(/\//g, '\\');
    var i = p.lastIndexOf('\\');
    return i > 0 ? p.substring(0, i) : 'C:\\';
}

function saveReport() {
    var path = scriptDir() + '\\e2e-report-' + fileStamp() + '.txt';
    var text = buildReport();
    try {
        var s = new ActiveXObject('ADODB.Stream');
        s.Type = 2;
        s.Charset = 'utf-8';
        s.Open();
        s.WriteText(text);
        s.SaveToFile(path, 2);
        s.Close();
    } catch (e) {
        alert('保存失败：' + e.message);
        return;
    }
    alert('报告已保存：\n' + path);
}

/* ---------- 初始化 ---------- */

function init() {
    try { window.resizeTo(1120, 790); } catch (e) { }
    try { window.moveTo(60, 40); } catch (e) { }
    renderTable();
    updateSummary();
    document.title = '大千智荟论坛 · 部署验收 E2E';
}

init();
</script>
</body>
</html>
