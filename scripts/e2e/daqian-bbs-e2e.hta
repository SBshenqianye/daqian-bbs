<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>大千智荟论坛 · 部署验收 E2E（Win7 HTA）</title>
<hta:application id="bbsE2E"
    applicationname="bbs-e2e"
    border="thin"
    caption="yes"
    icon="mshta.exe"
    maximizebutton="no"
    minimizebutton="yes"
    scroll="no"
    singleinstance="yes" />
<style type="text/css">
    html, body { margin: 0; padding: 0; background: #f4f6fa; color: #181c23;
        font-family: "Microsoft YaHei", "微软雅黑", Tahoma, Arial, sans-serif; font-size: 12.5px; }
    a { color: #0052d9; }
    .wrap { padding: 12px 16px 8px 16px; }
    .title { font-size: 17px; font-weight: bold; color: #0b2b66; }
    .title span { font-size: 11px; font-weight: normal; color: #7b8194; margin-left: 8px; }
    .card { background: #fff; border: 1px solid #dbe0ea; border-radius: 6px; padding: 9px 12px; margin-top: 9px; }
    .label { color: #5b6475; }
    input[type=text], input[type=password] {
        border: 1px solid #c9cfdb; border-radius: 4px; padding: 3px 6px; height: 20px;
        font-family: "Microsoft YaHei", Tahoma, Arial, sans-serif; font-size: 12.5px; }
    input[type=text]:focus, input[type=password]:focus { border-color: #7ba3ee; outline: none; }
    .btn { border: 1px solid #c3cbd9; background: #fff; color: #1f2a3d; border-radius: 4px;
        padding: 4px 12px; height: 26px; cursor: pointer; font-size: 12.5px;
        font-family: "Microsoft YaHei", Tahoma, Arial, sans-serif; }
    .btn:hover { border-color: #0052d9; color: #0052d9; }
    .btn-primary { background: #0052d9; border-color: #0052d9; color: #fff; }
    .btn-primary:hover { color: #fff; opacity: .9; }
    .btn[disabled] { color: #9aa2b1; border-color: #dfe3ea; background: #f5f6f8; cursor: default; }
    .summary { margin-top: 9px; padding: 7px 12px; background: #fff; border: 1px solid #dbe0ea; border-radius: 6px; }
    .summary b { font-size: 13.5px; }
    .ok { color: #0a7d33; }
    .fail { color: #c62828; }
    .skip { color: #8a6d1d; }
    .muted { color: #7b8194; }
    .bar { height: 6px; background: #e8ebf2; border-radius: 3px; margin-top: 7px; overflow: hidden; }
    .bar i { display: block; height: 6px; width: 0; background: #0052d9; }
    .gridWrap { height: 330px; overflow: auto; margin-top: 9px; border: 1px solid #dfe4ee; background: #fff; }
    table.grid { width: 100%; border-collapse: collapse; }
    table.grid th, table.grid td { border-bottom: 1px solid #eef1f6; padding: 4px 7px; text-align: left;
        vertical-align: top; font-size: 12px; }
    table.grid th { background: #f8fafd; color: #5b6475; font-weight: normal; position: sticky; top: 0; }
    table.grid tr.row { cursor: pointer; }
    table.grid tr.row:hover td { background: #f6f9ff; }
    table.grid tr.sel td { background: #eef4ff; }
    td.col-no { width: 32px; color: #8a91a1; }
    td.col-name { width: 210px; }
    td.col-state { width: 56px; }
    td.col-cost { width: 66px; color: #7b8194; }
    td.col-code { width: 52px; color: #7b8194; }
    .detail { margin-top: 9px; }
    .detail pre { margin: 5px 0 0 0; padding: 8px; background: #0f172a; color: #d7e2f5; border-radius: 5px;
        height: 132px; overflow: auto; font-family: Consolas, "Courier New", monospace; font-size: 11.5px;
        white-space: pre-wrap; word-wrap: break-word; }
    .hint { color: #7b8194; font-size: 11.5px; margin-top: 4px; }
    .warn { color: #a8620a; }
    .foot { margin-top: 6px; color: #8a91a1; font-size: 11px; }
</style>
</head>
<body>
<div class="wrap">
    <div class="title">大千智荟论坛 · 部署验收 E2E
        <span>单文件 HTA · 适用于 Windows 7（自带 mshta）</span>
    </div>

    <div class="card">
        <table cellspacing="0" cellpadding="0" border="0">
            <tr>
                <td class="label" width="66">服务地址</td>
                <td><input type="text" id="baseUrl" style="width:330px" value="http://127.0.0.1:9083/bbs-server"></td>
                <td class="label" width="64" align="right">超时(ms)</td>
                <td><input type="text" id="timeout" style="width:66px" value="15000"></td>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td class="label" style="padding-top:6px">验收账号</td>
                <td style="padding-top:6px"><input type="text" id="username" style="width:140px" value="">&nbsp;
                    <span class="label">密码</span>&nbsp;
                    <input type="password" id="password" style="width:140px" value=""></td>
                <td colspan="2" align="right" style="padding-top:6px">
                    <input type="checkbox" id="writeMode"> <span class="warn">包含写入用例</span>
                </td>
                <td>&nbsp;</td>
            </tr>
        </table>
        <div class="hint">只读用例不改数据；写入用例默认关闭，开启后会创建临时帖/评论并立即删除，点赞收藏会切回原状态。</div>
    </div>

    <div style="margin-top:9px">
        <button class="btn btn-primary" id="btnRun" onclick="startRun()">开始验收</button>
        <button class="btn" id="btnStop" onclick="stopRun()" disabled>停止</button>
        <button class="btn" id="btnSave" onclick="saveReport()">保存报告</button>
        <button class="btn" onclick="window.close()">关闭</button>
    </div>

    <div class="summary">
        <b id="summaryText">尚未开始</b>
        <span class="muted" id="summarySub"></span>
        <div class="bar"><i id="progressBar"></i></div>
    </div>

    <div class="gridWrap">
        <table class="grid" id="resultTable" cellspacing="0" cellpadding="0">
            <thead>
            <tr>
                <th class="col-no">#</th>
                <th>用例</th>
                <th class="col-state">结果</th>
                <th class="col-cost">耗时</th>
                <th class="col-code">HTTP</th>
                <th>说明</th>
            </tr>
            </thead>
            <tbody id="resultBody"></tbody>
        </table>
    </div>

    <div class="detail card" style="padding:7px 12px">
        <div class="label">明细（点击上面任意一行查看请求与响应）</div>
        <pre id="detail">（暂无）</pre>
    </div>

    <div class="foot">报告保存到本文件所在目录；仅使用系统自带组件（mshta + WinHttp + ADODB），无需安装运行库。</div>
</div>

<script type="text/javascript">
/* ============================================================
 * 大千智荟论坛 · 部署验收 E2E（Windows 7 单文件 HTA）
 *  - 纯 ES5 + ActiveX（WinHttp / ADODB），不依赖任何外部库与浏览器驱动；
 *  - [公共] 只读用例覆盖首页/帖子/评论/精华/排行/等级/组织；
 *  - [账号]/[消息] 用例需要验收账号；
 *  - [写入] 用例默认关闭，创建的数据会被立即清理。
 * ============================================================ */

var TESTS = [];
var LAST_HTTP = null;
var state = {
    running: false,
    stopRequested: false,
    results: [],
    startedAt: null,
    ctx: {}
};

/* ---------- 通用工具 ---------- */

function byId(id) { return document.getElementById(id); }

function trimStr(s) {
    if (s === null || s === undefined) return '';
    s = String(s);
    return s.replace(/^\s+|\s+$/g, '');
}

function pad2(n) { return n < 10 ? '0' + n : String(n); }

function nowText() {
    var d = new Date();
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()) + ' ' +
        pad2(d.getHours()) + ':' + pad2(d.getMinutes()) + ':' + pad2(d.getSeconds());
}

function fileStamp() {
    var d = new Date();
    return '' + d.getFullYear() + pad2(d.getMonth() + 1) + pad2(d.getDate()) + '-' +
        pad2(d.getHours()) + pad2(d.getMinutes()) + pad2(d.getSeconds());
}

function escapeHtml(s) {
    s = (s === null || s === undefined) ? '' : String(s);
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function clip(s, n) {
    s = (s === null || s === undefined) ? '' : String(s);
    return s.length > n ? s.substring(0, n) + ' ...' : s;
}

function isArray(v) {
    return Object.prototype.toString.call(v) === '[object Array]';
}

/** 统计分页/列表数据结构里的条数：数组直接取长度，{total}/{list} 取 total 或 list 长度 */
function countOf(data) {
    if (!data) return 0;
    if (isArray(data)) return data.length;
    if (typeof data.total === 'number') return data.total;
    if (isArray(data.list)) return data.list.length;
    if (isArray(data.records)) return data.records.length;
    return 0;
}

function must(cond, msg) {
    if (!cond) throw new Error(msg);
}

function skip(msg) {
    var e = new Error(msg || '已跳过');
    e.skipped = true;
    throw e;
}

/* ---------- UTF-8 编解码 ---------- */

function utf8Bytes(str) {
    var s = new ActiveXObject('ADODB.Stream');
    s.Type = 2;
    s.Charset = 'utf-8';
    s.Open();
    s.WriteText(str);
    s.Position = 0;
    s.Type = 1;
    var bytes = s.Read();
    s.Close();
    return bytes;
}

function decodeUtf8(bytes) {
    if (bytes === null || bytes === undefined) return '';
    var s = new ActiveXObject('ADODB.Stream');
    s.Type = 1;
    s.Open();
    s.Write(bytes);
    s.Position = 0;
    s.Type = 2;
    s.Charset = 'utf-8';
    var text = s.ReadText();
    s.Close();
    return text;
}

function parseJson(text) {
    if (!text) return null;
    try { if (typeof JSON !== 'undefined' && JSON.parse) return JSON.parse(text); } catch (e) { }
    try { return eval('(' + text + ')'); } catch (e2) { return null; }
}

/* ---------- HTTP ---------- */

function httpCall(method, path, body, useAuth) {
    var url = state.ctx.base + path;
    var xhr = new ActiveXObject('WinHttp.WinHttpRequest.5.1');
    xhr.Open(method, url, false);
    var to = parseInt(byId('timeout').value, 10);
    if (!to || to < 1000) to = 15000;
    xhr.SetTimeouts(to, to, to, to);
    xhr.SetRequestHeader('Accept', 'application/json');
    if (useAuth && state.ctx.token) xhr.SetRequestHeader('Authorization', state.ctx.token);
    if (body === null || body === undefined) {
        xhr.Send();
    } else {
        xhr.SetRequestHeader('Content-Type', 'application/json; charset=utf-8');
        xhr.Send(utf8Bytes(JSON.stringify(body)));
    }
    var record = {
        method: method,
        url: url,
        requestBody: (body === null || body === undefined) ? '' : JSON.stringify(body),
        status: xhr.Status,
        text: decodeUtf8(xhr.ResponseBody)
    };
    record.json = parseJson(record.text);
    LAST_HTTP = record;
    return record;
}

/** 标准 ResultBean：{code:200,message,obj} */
function expectOk(res, hint) {
    hint = hint || '';
    must(res.status === 200, 'HTTP ' + res.status + (hint ? '（' + hint + '）' : ''));
    must(res.json !== null, '响应不是 JSON：' + clip(res.text, 120));
    must(res.json.code === 200, '业务码 ' + res.json.code + '：' + (res.json.message || '无 message'));
    return res.json;
}

/** 裸对象/数组接口（帖子详情、用户信息、评论树、推荐/最新/热门等） */
function expectRaw(res) {
    must(res.status === 200, 'HTTP ' + res.status);
    must(res.json !== null && res.json !== undefined, '响应不是 JSON：' + clip(res.text, 120));
    return res.json;
}

/** 兼容两种结构：有 code 就校验 code，没有 code（裸 Map）则只看 HTTP */
function expectAnyOk(res) {
    must(res.status === 200, 'HTTP ' + res.status);
    must(res.json !== null && res.json !== undefined, '响应不是 JSON：' + clip(res.text, 120));
    if (typeof res.json.code !== 'undefined') {
        must(res.json.code === 200, '业务码 ' + res.json.code + '：' + (res.json.message || '无 message'));
    }
    return res.json;
}

/* ---------- 用例定义 ---------- */

function addTest(name, fn) { TESTS.push({ name: name, run: fn }); }

/* ===== 公共（免登录） ===== */

addTest('[公共] 服务可达性', function () {
    var res = httpCall('GET', '/common/featured/notices', null, false);
    expectOk(res);
    return 'GET /common/featured/notices 正常';
});

addTest('[公共] 轮播图', function () {
    var list = expectRaw(httpCall('GET', '/common/getSlideshow', null, false));
    must(isArray(list), '返回结构不是数组');
    return '轮播 ' + list.length + ' 条';
});

addTest('[公共] 标签列表', function () {
    var list = expectRaw(httpCall('GET', '/common/getArticleLabel', null, false));
    must(isArray(list) && list.length > 0, '标签列表为空');
    if (!state.ctx.labelId && list[0].labelId) state.ctx.labelId = list[0].labelId;
    return list.length + ' 个标签，取 labelId=' + state.ctx.labelId;
});

addTest('[公共] 组织树', function () {
    var json = expectOk(httpCall('GET', '/common/saOrgTree', null, false));
    must(isArray(json.obj) && json.obj.length > 0, '组织树为空');
    return '根节点 ' + json.obj.length + ' 个';
});

addTest('[公共] 帖子列表', function () {
    var json = expectOk(httpCall('POST', '/common/article/list', { page: 1, size: 10 }, false));
    var list = (json.obj && json.obj.list) || [];
    must(list.length > 0, '列表为空，无法继续验证帖子相关用例');
    state.ctx.articleId = list[0].articleId;
    state.ctx.labelId = list[0].articleLabelId || state.ctx.labelId;
    state.ctx.authorUserId = list[0].userId || null;
    state.ctx.firstTitle = list[0].articleTitle || '';
    return '共 ' + (json.obj.total || list.length) + ' 条，取 articleId=' + state.ctx.articleId;
});

addTest('[公共] 帖子搜索', function () {
    if (!state.ctx.firstTitle) skip('缺少可搜索的标题');
    var json = expectOk(httpCall('POST', '/common/article/list',
        { keywords: state.ctx.firstTitle, page: 1, size: 5 }, false));
    var list = (json.obj && json.obj.list) || [];
    must(list.length > 0, '按标题搜索无结果：' + clip(state.ctx.firstTitle, 24));
    return '搜索命中 ' + list.length + ' 条';
});

addTest('[公共] 按标签筛选', function () {
    if (!state.ctx.labelId) skip('缺少标签 id');
    var json = expectOk(httpCall('POST', '/common/article/list',
        { labelId: state.ctx.labelId, page: 1, size: 5 }, false));
    var list = (json.obj && json.obj.list) || [];
    return '标签 ' + state.ctx.labelId + ' 命中 ' + list.length + ' 条';
});

addTest('[公共] 帖子详情', function () {
    if (!state.ctx.articleId) skip('依赖帖子列表用例');
    var article = expectRaw(httpCall('POST',
        '/common/article/getArticleById/articleId/' + state.ctx.articleId, null, false));
    must(article && article.articleTitle, '详情缺少标题');
    var note = '标题：' + clip(article.articleTitle, 28);
    if (article.isFeatured === 1 || article.isFeatured === '1') note += '；精华帖';
    if (typeof article.selfAuthored === 'boolean') note += '；selfAuthored=' + article.selfAuthored;
    return note;
});

addTest('[公共] 帖子状态', function () {
    if (!state.ctx.articleId) skip('依赖帖子列表用例');
    var json = expectOk(httpCall('POST',
        '/common/article/getArticleStatus/articleId/' + state.ctx.articleId, null, false));
    var s = String(json.obj || '');
    must(s === 'NORMAL' || s === 'DELETED' || s === 'NOT_EXIST', '未知状态：' + s);
    return '状态：' + s;
});

addTest('[公共] 帖子附件', function () {
    if (!state.ctx.articleId) skip('依赖帖子列表用例');
    var list = expectRaw(httpCall('POST',
        '/common/getArticleFileByArticleId/' + state.ctx.articleId, null, false));
    must(isArray(list), '返回结构不是数组');
    return '附件 ' + list.length + ' 个';
});

addTest('[公共] 帖子互动状态', function () {
    if (!state.ctx.articleId) skip('依赖帖子列表用例');
    var json = expectAnyOk(httpCall('GET',
        '/common/article/interaction?articleId=' + state.ctx.articleId, null, false));
    return '互动状态：' + clip(JSON.stringify(json.obj !== undefined ? json.obj : json), 80);
});

addTest('[公共] 评论与回复', function () {
    if (!state.ctx.articleId) skip('依赖帖子列表用例');
    var list = expectRaw(httpCall('POST', '/common/comment/getCommentReply/' + state.ctx.articleId, null, false));
    must(isArray(list), '返回结构不是数组');
    var replyCount = 0;
    for (var i = 0; i < list.length; i++) {
        replyCount += (list[i].children ? list[i].children.length : 0);
    }
    return '评论 ' + list.length + ' 条，回复 ' + replyCount + ' 条';
});

addTest('[公共] 精华展示位', function () {
    var json = expectOk(httpCall('GET', '/common/featured/showcase', null, false));
    var list = json.obj || [];
    must(isArray(list), '返回结构不是数组');
    var hasContent = 0;
    for (var i = 0; i < list.length; i++) {
        must(list[i].articleId, '第 ' + (i + 1) + ' 条缺少 articleId');
        if (list[i].content) hasContent++;
    }
    var note = '展示 ' + list.length + ' 条';
    if (list.length > 0 && hasContent === 0) {
        note += '（提示：未返回 content 字段，封面兜底会退化为摘要）';
    }
    return note;
});

addTest('[公共] 精华公示', function () {
    var json = expectOk(httpCall('GET', '/common/featured/notices', null, false));
    must(isArray(json.obj), 'obj 不是数组');
    return '公示 ' + json.obj.length + ' 条';
});

addTest('[公共] 精华置顶', function () {
    var json = expectOk(httpCall('GET', '/common/article/getFeaturedTop', null, false));
    must(isArray(json.obj), 'obj 不是数组');
    return '置顶 ' + json.obj.length + ' 条';
});

addTest('[公共] 精华分页', function () {
    var json = expectAnyOk(httpCall('GET', '/common/article/getFeatured?page=1&size=5', null, false));
    var obj = json.obj !== undefined ? json.obj : json;
    var list = obj.list || [];
    must(isArray(list), 'obj.list 不是数组');
    return '本页 ' + list.length + ' 条，总计 ' + (obj.total || '-');
});

addTest('[公共] 首页推荐', function () {
    var list = expectRaw(httpCall('GET', '/common/article/getRecommend', null, false));
    must(isArray(list), '返回结构不是数组');
    return '推荐 ' + list.length + ' 条';
});

addTest('[公共] 最新帖子', function () {
    var list = expectRaw(httpCall('GET', '/common/article/getNewest', null, false));
    must(isArray(list), '返回结构不是数组');
    return '最新 ' + list.length + ' 条';
});

addTest('[公共] 热门帖子', function () {
    var list = expectRaw(httpCall('GET', '/common/article/getHot', null, false));
    must(isArray(list), '返回结构不是数组');
    return '热门 ' + list.length + ' 条';
});

addTest('[公共] 标签热榜', function () {
    if (!state.ctx.labelId) skip('缺少标签 id');
    var json = expectOk(httpCall('POST', '/common/article/hot',
        { labelId: state.ctx.labelId, metric: 'views', range: 'all', limit: 5 }, false));
    var obj = json.obj;
    var list = isArray(obj) ? obj : (obj && obj.list ? obj.list : []);
    must(isArray(list), '返回结构不含列表');
    return '热榜 ' + list.length + ' 条';
});

addTest('[公共] 排行榜分类', function () {
    var json = expectOk(httpCall('GET', '/common/ranking/categories', null, false));
    var list = json.obj || [];
    must(isArray(list) && list.length > 0, '分类为空（迁移种子可能未执行）');
    state.ctx.categoryId = list[0].id;
    var names = [];
    for (var i = 0; i < list.length && i < 5; i++) names.push(list[i].categoryName);
    return list.length + ' 个分类：' + names.join('、');
});

addTest('[公共] 组织排行榜', function () {
    if (!state.ctx.categoryId) skip('依赖排行榜分类用例');
    var json = expectOk(httpCall('POST', '/common/ranking/org', { categoryId: state.ctx.categoryId }, false));
    must(isArray(json.obj), '返回结构不是数组');
    return '分类 ' + state.ctx.categoryId + ' 共 ' + json.obj.length + ' 个组织上榜';
});

addTest('[公共] 积分排行榜', function () {
    var json = expectOk(httpCall('POST', '/common/pointsRank', { rankType: '02' }, false));
    must(isArray(json.obj), '返回结构不是数组');
    return '累计榜 ' + json.obj.length + ' 个单位';
});

addTest('[公共] 等级方案', function () {
    var json = expectOk(httpCall('GET', '/common/level/profile', null, false));
    var profile = json.obj && json.obj.profile;
    must(profile && profile.id, '缺少当前等级方案');
    var note = '方案：' + (profile.profileName || '-') + '（id=' + profile.id + '）';
    if (json.obj.items && json.obj.items.length) note += '，等级 ' + json.obj.items.length + ' 级';
    return note;
});

addTest('[公共] 用户公开资料', function () {
    if (!state.ctx.authorUserId) skip('缺少可验证的用户 id');
    var json = expectOk(httpCall('GET', '/common/user/publicProfile/' + state.ctx.authorUserId, null, false));
    must(json.obj, 'obj 为空');
