    return '已收藏并取消（articleId=' + state.ctx.articleId + '）';
});

addTest('[写入] 评论→删除', function () {
    if (!byId('writeMode').checked) skip('未开启写入用例');
    if (!state.ctx.user) skip('依赖登录用例');
    if (!state.ctx.articleId) skip('依赖帖子列表用例');

    var content = 'E2E评论-' + fileStamp();
    expectOk(httpCall('PUT', '/comment/userComment', {
        commentContent: content,
        commentUserId: state.ctx.user.id,
        commentArticleId: state.ctx.articleId,
        isAnonymous: 0
    }, true));

    var commentId = findCommentId(content);
    if (commentId === null) {
        throw new Error('评论已提交但未查到记录，请人工确认是否残留：' + content);
    }
    expectOk(httpCall('POST', '/comment/deleteCommentById', { commentId: commentId }, true));
    return '已创建并删除 commentId=' + commentId;
});

/* ---------- 写入用例辅助：短轮询查找 ---------- */

function sleepBrief(ms) {
    var end = new Date().getTime() + ms;
    while (new Date().getTime() < end) { /* HTA 同步等待，仅用于短轮询 */ }
}

function findArticleByTitle(title) {
    var deadline = new Date().getTime() + 5000;
    while (new Date().getTime() < deadline) {
        var res = httpCall('POST', '/common/article/list', { keywords: title, page: 1, size: 5 }, true);
        if (res.json && res.json.obj && res.json.obj.list) {
            var list = res.json.obj.list;
            for (var i = 0; i < list.length; i++) {
                if (String(list[i].articleTitle) === title) return list[i].articleId;
            }
        }
        sleepBrief(600);
    }
    return null;
}

function findCommentId(content) {
    var deadline = new Date().getTime() + 5000;
    while (new Date().getTime() < deadline) {
        var res = httpCall('POST', '/common/comment/getCommentReply/' + state.ctx.articleId, null, true);
        var list = res.json;
        if (isArray(list)) {
            for (var i = 0; i < list.length; i++) {
                if (String(list[i].commentContent) === content) return list[i].commentId;
            }
        }
        sleepBrief(600);
    }
    return null;
}

/* ---------- 执行器 ---------- */

function renderTable() {
    var html = [];
    for (var i = 0; i < TESTS.length; i++) {
        var r = state.results[i] || { state: 'pending', cost: '', http: '', note: '' };
        var cls = r.state === 'ok' ? 'ok' : (r.state === 'fail' ? 'fail' : (r.state === 'skip' ? 'skip' : 'muted'));
        var label = r.state === 'ok' ? '通过' : (r.state === 'fail' ? '失败' : (r.state === 'skip' ? '跳过' : '待执行'));
        html.push('<tr class="row" id="row' + i + '" onclick="selectRow(' + i + ')">' +
            '<td class="col-no">' + (i + 1) + '</td>' +
            '<td class="col-name">' + escapeHtml(TESTS[i].name) + '</td>' +
            '<td class="col-state ' + cls + '">' + label + '</td>' +
            '<td class="col-cost">' + escapeHtml(r.cost) + '</td>' +
            '<td class="col-code">' + escapeHtml(r.http) + '</td>' +
            '<td>' + escapeHtml(r.note) + '</td>' +
            '</tr>');
    }
    byId('resultBody').innerHTML = html.join('');
}

function updateSummary() {
    var ok = 0, fail = 0, skipCount = 0, done = 0;
    for (var i = 0; i < state.results.length; i++) {
        var s = state.results[i].state;
        if (!s || s === 'pending') continue;
        done++;
        if (s === 'ok') ok++;
        else if (s === 'fail') fail++;
        else skipCount++;
    }
    var total = TESTS.length;
    var text = '通过 ' + ok + ' · 失败 ' + fail + ' · 跳过 ' + skipCount + ' · 共 ' + total;
    byId('summaryText').innerHTML = fail > 0 ? '<span class="fail">' + text + '</span>' : text;
    var sub = '';
    if (state.startedAt) sub = '开始时间 ' + state.startedAt + (state.running ? ' · 运行中…' : ' · 已结束');
    byId('summarySub').innerHTML = sub ? '&nbsp;&nbsp;' + escapeHtml(sub) : '';
    var pct = total > 0 ? Math.round(done * 100 / total) : 0;
    byId('progressBar').style.width = pct + '%';
    byId('btnRun').disabled = state.running;
    byId('btnStop').disabled = !state.running;
}

function selectRow(i) {
    for (var k = 0; k < TESTS.length; k++) {
        var row = byId('row' + k);
        if (row && row.className.indexOf('sel') >= 0) row.className = 'row';
    }
    var cur = byId('row' + i);
    if (cur) cur.className = 'row sel';
    var r = state.results[i];
    if (!r) { byId('detail').innerHTML = '（尚未执行）'; return; }
    var lines = [];
    lines.push('用例：' + TESTS[i].name);
    lines.push('结果：' + (r.state === 'ok' ? '通过' : (r.state === 'fail' ? '失败' : '跳过')));
    if (r.note) lines.push('说明：' + r.note);
    if (r.http) lines.push('HTTP：' + r.http);
    if (r.method) lines.push(r.method + ' ' + r.requestUrl);
    if (r.requestBody) lines.push('请求体：' + r.requestBody);
    if (r.responseText) {
        lines.push('');
        lines.push('响应：');
        lines.push(clip(r.responseText, 4000));
    }
    byId('detail').innerHTML = escapeHtml(lines.join('\n'));
}

function startRun() {
    if (state.running) return;
    var base = trimStr(byId('baseUrl').value);
    if (!base) { alert('请填写服务地址'); return; }
    base = base.replace(/\/+$/, '');
    if (!/^https?:\/\//i.test(base)) { alert('服务地址需以 http:// 或 https:// 开头'); return; }

    state.running = true;
    state.stopRequested = false;
    state.results = [];
    state.startedAt = nowText();
    state.ctx = { base: base, token: '', user: null, articleId: null, labelId: null, categoryId: null, authorUserId: null, firstTitle: '' };
    byId('detail').innerHTML = '（暂无）';
    renderTable();
    updateSummary();
    runNext(0);
}

function stopRun() {
    if (!state.running) return;
    state.stopRequested = true;
    byId('summarySub').innerHTML = '&nbsp;&nbsp;<span class="warn">正在停止…（等待当前用例结束）</span>';
}

function runNext(index) {
    if (!state.running) return;
    if (state.stopRequested) { finishRun(); return; }
    if (index >= TESTS.length) { finishRun(); return; }

    var test = TESTS[index];
    var started = new Date().getTime();
    var result = { state: 'pending', cost: '', http: '', note: '' };
    state.results[index] = result;
    renderTable();
    updateSummary();

    setTimeout(function () {
        LAST_HTTP = null;
        try {
            result.note = test.run() || '';
            result.state = 'ok';
        } catch (e) {
            if (e && e.skipped) {
                result.state = 'skip';
                result.note = e.message || '已跳过';
            } else {
                result.state = 'fail';
                result.note = (e && e.message) ? e.message : String(e);
            }
        }
        result.cost = (new Date().getTime() - started) + ' ms';
        if (LAST_HTTP) {
            result.http = String(LAST_HTTP.status);
            result.method = LAST_HTTP.method;
            result.requestUrl = LAST_HTTP.url;
            result.requestBody = LAST_HTTP.requestBody;
            result.responseText = LAST_HTTP.text;
        }
        renderTable();
        updateSummary();
        selectRow(index);
        runNext(index + 1);
    }, 25);
}

function finishRun() {
    state.running = false;
    state.stopRequested = false;
    updateSummary();
    var ok = 0, fail = 0;
    for (var i = 0; i < state.results.length; i++) {
        if (state.results[i].state === 'ok') ok++;
        if (state.results[i].state === 'fail') fail++;
    }
    if (fail > 0) {
        alert('验收结束：通过 ' + ok + ' 个，失败 ' + fail + ' 个。\n请查看失败用例的说明与响应明细。');
    }
}

/* ---------- 报告 ---------- */

function buildReport() {
    var lines = [];
    lines.push('大千智荟论坛 · 部署验收 E2E 报告');
    lines.push('生成时间：' + nowText());
    lines.push('服务地址：' + state.ctx.base);
    lines.push('验收账号：' + (state.ctx.user ? (state.ctx.user.nickname || state.ctx.user.username) : trimStr(byId('username').value) || '(未填写)'));
    lines.push('写入用例：' + (byId('writeMode').checked ? '已开启' : '未开启'));
    lines.push('');
    var ok = 0, fail = 0, skipCount = 0;
    for (var i = 0; i < TESTS.length; i++) {
        var r = state.results[i] || { state: 'pending', note: '未执行', cost: '', http: '' };
        var label = r.state === 'ok' ? 'PASS' : (r.state === 'fail' ? 'FAIL' : (r.state === 'skip' ? 'SKIP' : 'TODO'));
        if (r.state === 'ok') ok++;
        if (r.state === 'fail') fail++;
        if (r.state === 'skip') skipCount++;
        lines.push('[' + label + '] ' + (i + 1) + '. ' + TESTS[i].name + '  (' + (r.cost || '-') + ')');
        if (r.note) lines.push('      说明：' + r.note);
        if (r.method) lines.push('      请求：' + r.method + ' ' + r.requestUrl);
        if (r.responseText) lines.push('      响应：' + clip(String(r.responseText).replace(/\s+/g, ' '), 400));
        if (r.state === 'fail') lines.push('');
    }
    lines.push('');
    lines.push('汇总：通过 ' + ok + ' / 失败 ' + fail + ' / 跳过 ' + skipCount + ' / 共 ' + TESTS.length);
    return lines.join('\r\n');
}

function scriptDir() {
    var p;
    try { p = unescape(window.location.pathname); } catch (e) { p = String(window.location.pathname); }
    if (p.charAt(0) === '/' && p.charAt(2) === ':') p = p.substring(1);
    p = p.replace(/\//g, '\\');
    var i = p.lastIndexOf('\\');
    return i > 0 ? p.substring(0, i) : 'C:\\';
}

function saveReport() {
    var path = scriptDir() + '\\e2e-report-' + fileStamp() + '.txt';
    var text = buildReport();
    try {
        var s = new ActiveXObject('ADODB.Stream');
        s.Type = 2;
        s.Charset = 'utf-8';
        s.Open();
        s.WriteText(text);
        s.SaveToFile(path, 2);
        s.Close();
    } catch (e) {
        alert('保存失败：' + e.message);
        return;
    }
    alert('报告已保存：\n' + path);
}

/* ---------- 初始化 ---------- */

function init() {
    try { window.resizeTo(1140, 800); } catch (e) { }
    try { window.moveTo(60, 40); } catch (e) { }
    renderTable();
    updateSummary();
    document.title = '大千智荟论坛 · 部署验收 E2E';
}

init();
</script>
</body>
</html>

